---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const lang = 'en';

const pageTitle = "SRT Merger — Combine Multiple Subtitle Files Online Free | FreeAutoCaption";
const pageDesc = "Merge and join multiple SRT, VTT, or ASS subtitle files into one continuous file. Automatic time offset calculation and sequential re-indexing.";
---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDesc}
  path="/srt-merger"
>
  <div class="relative overflow-hidden pt-12 pb-20">
    <!-- Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-gradient-to-b from-[var(--color-grad-coral-start)]/10 via-[var(--color-warning)]/5 to-transparent blur-3xl -z-10 pointer-events-none"></div>

    <div class="container-page flex flex-col gap-12">
      <!-- Header -->
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto gap-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[var(--color-warning)] animate-pulse"></span>
          <span class="text-xs font-semibold text-[var(--color-ink)] uppercase tracking-wider">Subtitle Joiner & Merger</span>
        </div>

        <h1 class="display-xl text-[var(--color-ink)] tracking-tight">
          Merge Multiple Subtitle Files Online
        </h1>

        <p class="body-lg text-[var(--color-body)] max-w-2xl">
          Combine multi-part subtitles (Part 1, Part 2, etc.) into one master file. Set time gaps or automatic sequential chaining and export clean <strong>.SRT or .VTT</strong> files.
        </p>
      </div>

      <!-- Merger Card -->
      <div class="bg-[var(--color-canvas)] rounded-2xl border border-[var(--color-hairline)] shadow-l3 p-6 md:p-8 flex flex-col gap-8">
        
        <!-- File Uploads -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label class="text-xs font-semibold text-[var(--color-ink)] uppercase tracking-wider">File 1 (Base Subtitles)</label>
            <label
              for="merge-file-1"
              class="flex flex-col items-center justify-center gap-3 w-full min-h-[140px] p-4 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-ink)] rounded-2xl cursor-pointer transition-all text-center bg-[var(--color-canvas-soft)]"
            >
              <span class="text-2xl">📁</span>
              <p id="merge-file-1-name" class="text-xs font-semibold text-[var(--color-ink)]">Upload First Subtitle File (.SRT/.VTT)</p>
              <input id="merge-file-1" type="file" accept=".srt,.vtt,.ass,.txt" class="sr-only" />
            </label>
          </div>

          <div class="flex flex-col gap-2">
            <label class="text-xs font-semibold text-[var(--color-ink)] uppercase tracking-wider">File 2 (Append / Part 2)</label>
            <label
              for="merge-file-2"
              class="flex flex-col items-center justify-center gap-3 w-full min-h-[140px] p-4 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-ink)] rounded-2xl cursor-pointer transition-all text-center bg-[var(--color-canvas-soft)]"
            >
              <span class="text-2xl">📁</span>
              <p id="merge-file-2-name" class="text-xs font-semibold text-[var(--color-ink)]">Upload Second Subtitle File (.SRT/.VTT)</p>
              <input id="merge-file-2" type="file" accept=".srt,.vtt,.ass,.txt" class="sr-only" />
            </label>
          </div>
        </div>

        <!-- Chaining Offset Options -->
        <div class="p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex flex-col">
            <span class="text-xs font-bold text-[var(--color-ink)]">Chaining Offset Mode</span>
            <span class="text-[11px] text-[var(--color-mute)]">Auto-append starts Part 2 right after the last timestamp of Part 1.</span>
          </div>
          <div class="flex items-center gap-2">
            <button id="merge-sample-btn" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)]">
              Load Sample Files
            </button>
            <button id="merge-action-btn" class="px-5 py-2 text-xs font-bold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-90 shadow-l1">
              Merge Subtitles Now ⚡
            </button>
          </div>
        </div>

        <!-- Merged Output -->
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-bold text-[var(--color-ink)]">Merged Output Preview</h3>
            <span id="merge-cue-count" class="text-xs font-medium text-[var(--color-mute)]">0 cues merged</span>
          </div>

          <textarea
            id="merge-output-preview"
            rows="8"
            readonly
            class="w-full p-4 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-xs font-mono text-[var(--color-ink)] select-all"
          ></textarea>

          <div class="flex flex-wrap items-center gap-3">
            <button id="merge-download-srt" class="px-6 py-2.5 rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] text-xs font-semibold hover:opacity-90 transition-all shadow-l1">
              Download Merged .SRT
            </button>
            <button id="merge-download-vtt" class="px-4 py-2.5 rounded-pill bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:border-[var(--color-hairline-strong)] text-[var(--color-ink)] text-xs font-semibold transition-all">
              Download .WebVTT
            </button>
            <button id="merge-copy-btn" class="px-4 py-2.5 rounded-pill bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:border-[var(--color-hairline-strong)] text-[var(--color-ink)] text-xs font-semibold transition-all">
              📋 Copy to Clipboard
            </button>
          </div>
        </div>

      </div>

      <!-- FAQ -->
      <FaqAccordion lang={lang} />
    </div>
  </div>
</Layout>

<script>
  import { parseSubtitleText, serializeToSRT, serializeToVTT, mergeSubtitleFiles, type SubtitleCue } from '../utils/subtitleParser';

  let cues1: SubtitleCue[] = [];
  let cues2: SubtitleCue[] = [];
  let merged: SubtitleCue[] = [];

  const file1Input = document.getElementById('merge-file-1') as HTMLInputElement;
  const file2Input = document.getElementById('merge-file-2') as HTMLInputElement;
  const file1Name = document.getElementById('merge-file-1-name');
  const file2Name = document.getElementById('merge-file-2-name');
  const outputPreview = document.getElementById('merge-output-preview') as HTMLTextAreaElement;
  const cueCount = document.getElementById('merge-cue-count');

  function doMerge() {
    if (cues1.length === 0 && cues2.length === 0) {
      if (outputPreview) outputPreview.value = '';
      if (cueCount) cueCount.textContent = '0 cues merged';
      return;
    }

    const lastCue1 = cues1[cues1.length - 1];
    const offset = lastCue1 ? lastCue1.end + 1.0 : 0;
    merged = mergeSubtitleFiles(cues1, cues2, offset);

    if (outputPreview) outputPreview.value = serializeToSRT(merged);
    if (cueCount) cueCount.textContent = `${merged.length} cues merged successfully`;
  }

  file1Input?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const text = await file.text();
      cues1 = parseSubtitleText(text, file.name);
      if (file1Name) file1Name.textContent = `✓ ${file.name} (${cues1.length} cues)`;
      doMerge();
    }
  });

  file2Input?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const text = await file.text();
      cues2 = parseSubtitleText(text, file.name);
      if (file2Name) file2Name.textContent = `✓ ${file.name} (${cues2.length} cues)`;
      doMerge();
    }
  });

  document.getElementById('merge-action-btn')?.addEventListener('click', doMerge);

  document.getElementById('merge-sample-btn')?.addEventListener('click', () => {
    cues1 = [
      { id: 1, start: 0.0, end: 2.5, text: "Part 1: In the beginning of the video..." },
      { id: 2, start: 2.6, end: 5.0, text: "We discussed how AI subtitles work." },
    ];
    cues2 = [
      { id: 1, start: 0.0, end: 2.8, text: "Part 2: Now we continue with the next chapter." },
      { id: 2, start: 2.9, end: 5.5, text: "And here is the conclusion!" },
    ];
    if (file1Name) file1Name.textContent = '✓ Sample_Part1.srt (2 cues)';
    if (file2Name) file2Name.textContent = '✓ Sample_Part2.srt (2 cues)';
    doMerge();
  });

  // Downloads
  function triggerDownload(content: string, filename: string, type: string) {
    if (!content) return alert('No merged subtitles to download.');
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  document.getElementById('merge-download-srt')?.addEventListener('click', () => {
    triggerDownload(serializeToSRT(merged), 'merged-subtitles.srt', 'text/plain');
  });

  document.getElementById('merge-download-vtt')?.addEventListener('click', () => {
    triggerDownload(serializeToVTT(merged), 'merged-subtitles.vtt', 'text/vtt');
  });

  document.getElementById('merge-copy-btn')?.addEventListener('click', () => {
    const text = serializeToSRT(merged);
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => alert('✓ Merged subtitles copied to clipboard!'));
  });

  // Load sample initially
  document.getElementById('merge-sample-btn')?.click();
</script>
