---
import Layout from '../layouts/Layout.astro';
import { t, getLocalizedUrl } from '../i18n/utils';

const lang = 'en';

const sections = [
  {
    title: 'Our Mission',
    body: 'We believe creating high-quality, engaging video content shouldn\'t require expensive monthly software subscriptions. Subtitle Generator Free was built to give every creator, podcaster, educator, and filmmaker access to viral, high-converting animated subtitles without paywalls or watermarks.',
  },
  {
    title: '100% Client-Side Privacy Guarantee',
    body: 'Unlike traditional cloud video editors that upload your private video files to remote servers, Subtitle Generator Free processes your media entirely inside your browser sandbox. Your audio tracks, videos, and scripts never leave your machine.',
  },
  {
    title: 'Modern Web Engineering',
    body: 'Built on Astro v7 and Tailwind CSS v4, our engine harnesses modern web standards including the Web Speech API, HTML5 Canvas, and the MediaRecorder API to deliver zero-lag playback and real-time caption rendering directly on your GPU.',
  },
];
---

<Layout
  lang={lang}
  path="/about"
  title="About — Subtitle Generator Free"
  description="Learn about our mission to provide 100% free, private, and watermark-free AI subtitle tools for creators worldwide."
>
  <!-- Header -->
  <section class="bg-[var(--color-canvas)] border-b border-[var(--color-hairline)] pt-16 pb-12">
    <div class="container-page max-w-3xl mx-auto">
      <span class="eyebrow">{t(lang, 'nav.about')}</span>
      <h1 class="display-xl text-[var(--color-ink)] font-extrabold mt-2">
        Democratizing Video Captioning for Every Creator
      </h1>
    </div>
  </section>

  <!-- Content Sections -->
  <section class="py-16 md:py-24 bg-[var(--color-canvas-soft)]">
    <div class="container-page max-w-3xl mx-auto flex flex-col gap-10">
      {sections.map((sec) => (
        <div class="p-8 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex flex-col gap-3">
          <h2 class="display-sm text-[var(--color-ink)] font-bold">{sec.title}</h2>
          <p class="text-base text-[var(--color-body)] leading-relaxed">
            {sec.body}
          </p>
        </div>
      ))}

      <!-- Privacy Policy Section -->
      <div id="privacy" class="p-8 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex flex-col gap-4 scroll-mt-24">
        <h2 class="display-sm text-[var(--color-ink)] font-bold">Privacy Policy</h2>
        <p class="text-sm text-[var(--color-body)] leading-relaxed">
          FreeAutoCaption is designed with a strict privacy-first architecture. All media processing, including video rendering, subtitle merging, timestamp synchronization, and subtitle conversions happen entirely on your local machine using client-side Web APIs (HTML5 Canvas, Web Audio API, and MediaRecorder).
        </p>
        <p class="text-sm text-[var(--color-body)] leading-relaxed">
          When using the cloud-powered transcription feature, audio chunks are sent securely over HTTPS to Cloudflare Workers AI edge GPUs for transcription and are immediately discarded. We do not store, log, or sell your files or transcripts.
        </p>
      </div>

      <!-- Terms of Service Section -->
      <div id="terms" class="p-8 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex flex-col gap-4 scroll-mt-24">
        <h2 class="display-sm text-[var(--color-ink)] font-bold">Terms of Service</h2>
        <p class="text-sm text-[var(--color-body)] leading-relaxed">
          FreeAutoCaption is provided free of charge for personal and commercial content creators. You retain full ownership of all videos, audio files, and subtitle files you upload or generate.
        </p>
        <p class="text-sm text-[var(--color-body)] leading-relaxed">
          The service is provided "as is" without warranty of any kind. You agree not to use the service for generating or distributing unlawful or infringing material.
        </p>
      </div>

      <!-- Contact Section -->
      <div id="contact" class="p-8 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex flex-col gap-4 scroll-mt-24">
        <h2 class="display-sm text-[var(--color-ink)] font-bold">Contact & Support</h2>
        <p class="text-sm text-[var(--color-body)] leading-relaxed">
          Have questions, suggestions, or need assistance? Reach out to our community and development team:
        </p>
        <div class="flex items-center gap-3">
          <a
            href="mailto:support@freeautocaption.com"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-sm font-semibold text-[var(--color-ink)] hover:border-[var(--color-link)] transition-colors"
          >
            ✉️ support@freeautocaption.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 bg-[var(--color-canvas)] border-t border-[var(--color-hairline)] text-center">
    <div class="container-page flex flex-col items-center gap-6">
      <h2 class="display-md font-bold text-[var(--color-ink)]">{t(lang, 'cta.title')}</h2>
      <a
        href={getLocalizedUrl(lang, '/#subtitle-studio')}
        class="inline-flex items-center h-12 px-8 text-sm font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-opacity shadow-l2"
      >
        {t(lang, 'cta.button')}
      </a>
    </div>
  </section>
</Layout>
