---
import { t, getLocalizedUrl } from '../i18n/utils';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
---

<section class="relative pt-12 pb-6 md:pt-16 md:pb-8 overflow-hidden">
  <!-- Soft Ambient Glow & Subtle Glass Elements in Background (Matching Screenshot) -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute -top-[25%] left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full blur-3xl opacity-40 dark:opacity-20 bg-gradient-to-b from-sky-200 via-blue-100 to-transparent dark:from-sky-950 dark:via-blue-950"></div>
    <!-- Floating Frosted Glass Cards (Decorative) -->
    <div class="hidden md:block absolute top-12 left-8 lg:left-16 w-32 h-24 rounded-3xl bg-white/40 dark:bg-white/5 backdrop-blur-md border border-white/60 dark:border-white/10 shadow-sm opacity-60 transform -rotate-6 pointer-events-none"></div>
    <div class="hidden md:block absolute top-48 left-4 lg:left-12 w-28 h-28 rounded-3xl bg-white/40 dark:bg-white/5 backdrop-blur-md border border-white/60 dark:border-white/10 shadow-sm opacity-50 transform rotate-12 pointer-events-none"></div>
    <div class="hidden md:block absolute top-20 right-8 lg:right-16 w-36 h-28 rounded-3xl bg-white/40 dark:bg-white/5 backdrop-blur-md border border-white/60 dark:border-white/10 shadow-sm opacity-60 transform rotate-6 pointer-events-none"></div>
    <div class="hidden md:block absolute top-52 right-4 lg:right-12 w-28 h-28 rounded-3xl bg-white/40 dark:bg-white/5 backdrop-blur-md border border-white/60 dark:border-white/10 shadow-sm opacity-50 transform -rotate-12 pointer-events-none"></div>
  </div>

  <div class="container-page max-w-3xl mx-auto text-center flex flex-col items-center gap-4">

    <!-- Main Headline -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--color-ink)] tracking-tight font-sans">
      Auto Caption Generator
    </h1>

    <!-- Subtitle Paragraph -->
    <p class="text-sm sm:text-base text-[var(--color-body)] max-w-2xl mx-auto leading-relaxed text-balance">
      A free caption generator that adds animated captions to any video — automatically. Upload a clip, auto-generate captions, pick a style, and export a captioned MP4 right in your browser. Got a song instead? Drop an MP3 to turn it into a lyric video. Free to try — no sign-up to generate, and unlimited free exports. No install needed.
    </p>

    <!-- Star Ratings & Feedback Pill -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-1">
      <div class="flex items-center gap-1.5 text-xs font-semibold text-[var(--color-ink)]">
        <span class="text-amber-400 text-sm tracking-widest">★★★★★</span>
        <span class="font-bold">4.7</span>
        <span class="text-[var(--color-mute)] font-normal">2,401 ratings</span>
      </div>

      <button
        id="open-feedback-modal-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3.5 py-1 text-xs font-medium rounded-pill border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-xs transition-all"
      >
        <span class="text-xs">💬</span>
        <span>Have feedback?</span>
      </button>
    </div>

  </div>
</section>

