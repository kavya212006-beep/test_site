  const cuesContainer = document.getElementById('cues-container');

  function updateSubtitleAtTime(time: number) {
    if (!subtitleRenderBox) return;

    const activeCue = currentCues.find(c => time >= c.start && time <= c.end);
    if (!activeCue) {
      subtitleRenderBox.innerHTML = '';
      subtitleRenderBox.style.opacity = '0';
      return;
    }

    subtitleRenderBox.style.opacity = '1';
    const words = activeCue.text.trim().split(/\s+/).filter(Boolean);
    if (words.length === 0) return;

    const cueDuration = Math.max(0.1, activeCue.end - activeCue.start);
    const progress = Math.min(0.99, Math.max(0, (time - activeCue.start) / cueDuration));
    const activeWordIdx = Math.floor(progress * words.length);

    const wordsHtml = words.map((w, idx) => {
      const isWordActive = idx === activeWordIdx;
      let wordStyle = '';

      if (isWordActive) {
        wordStyle = `color: ${typoState.highlightColor}; transform: scale(1.15); display: inline-block; font-weight: 900;`;
        if (typoState.shadow) {
          wordStyle += ` text-shadow: 0 0 16px ${typoState.highlightColor}, 2px 2px 0 #000, -2px -2px 0 #000;`;
        }
      } else {
        wordStyle = `color: ${typoState.baseColor}; display: inline-block;`;
      }

      return `<span class="inline-block mx-1 transition-all duration-75 ${isWordActive ? 'word-active' : ''}" style="${wordStyle}">${w}</span>`;
    }).join(' ');

    subtitleRenderBox.innerHTML = wordsHtml;
  }

  studioVideo?.addEventListener('timeupdate', () => {
    const time = studioVideo.currentTime;
    const duration = studioVideo.duration || 12;
    if (ctrlSeekbar && duration > 0) {
