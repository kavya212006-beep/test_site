---
import { t } from '../../i18n/utils';

interface Props {
  lang: string;
  initialMode?: 'ai' | 'burn';
}
const { lang, initialMode = 'ai' } = Astro.props;

const stylePresets = [
  { id: 'hormozi', nameKey: 'styles.hormozi', icon: '🔥', font: 'Outfit', color: '#ffffff', highlight: '#facc15', stroke: 0, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Bold yellow pop, high-energy viral retention' },
  { id: 'beast', nameKey: 'styles.beast', icon: '⚡', font: 'Syne', color: '#ffffff', highlight: '#38bdf8', stroke: 2, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Thick black stroke with cyan bounce' },
  { id: 'cinematic', nameKey: 'styles.cinematic', icon: '🎬', font: 'Inter', color: '#ffffff', highlight: '#60a5fa', stroke: 0, shadow: false, bg: 'frosted', transform: 'none', desc: 'Frosted dark pill box for film & docs' },
  { id: 'neon', nameKey: 'styles.neon', icon: '💜', font: 'Space Grotesk', color: '#ffffff', highlight: '#ff0080', stroke: 0, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Cyberpunk glowing cyan & pink neon' },
  { id: 'bangers', nameKey: 'styles.bangers', icon: '💥', font: 'Bangers', color: '#facc15', highlight: '#ff0055', stroke: 2, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Comic action pop with heavy stroke' },
  { id: 'marker', nameKey: 'styles.marker', icon: '✍️', font: 'Permanent Marker', color: '#ffffff', highlight: '#a855f7', stroke: 0, shadow: true, bg: 'none', transform: 'none', desc: 'Urban handwritten graffiti style' },
  { id: 'bebas', nameKey: 'styles.bebas', icon: '🚀', font: 'Bebas Neue', color: '#ffffff', highlight: '#fb923c', stroke: 0, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Tall condensed viral headline punch' },
  { id: 'karaoke', nameKey: 'styles.karaoke', icon: '🎤', font: 'Outfit', color: 'rgba(255,255,255,0.7)', highlight: '#4ade80', stroke: 0, shadow: true, bg: 'none', transform: 'none', desc: 'Smooth progressive green highlight' },
  { id: 'minimal', nameKey: 'styles.minimal', icon: '✨', font: 'Inter', color: '#ffffff', highlight: '#ffffff', stroke: 0, shadow: false, bg: 'none', transform: 'none', desc: 'Clean modern typography' },
];

const fontFamilies = [
  { name: 'Outfit (Viral Standard)', value: 'Outfit', category: 'Modern Geometric Sans' },
  { name: 'Anton (Ultra Bold Impact)', value: 'Anton', category: 'Headline Bold' },
  { name: 'Montserrat (Heavy Black 900)', value: 'Montserrat', category: 'Bold Punch' },
  { name: 'Bebas Neue (Tall Condensed)', value: 'Bebas Neue', category: 'Cinematic Hook' },
  { name: 'Syne (High-Energy Punch)', value: 'Syne', category: 'Trendy Viral' },
  { name: 'Bangers (Comic Action / Beast)', value: 'Bangers', category: 'Comic Cartoon' },
  { name: 'Luckiest Guy (Playful Bold)', value: 'Luckiest Guy', category: 'Playful Punch' },
  { name: 'Permanent Marker (Graffiti / Urban)', value: 'Permanent Marker', category: 'Handwritten' },
  { name: 'Space Grotesk (Cyberpunk Neon)', value: 'Space Grotesk', category: 'Futuristic' },
  { name: 'Cinzel (Epic Cinematic)', value: 'Cinzel', category: 'Luxury Film' },
  { name: 'Playfair Display (Editorial Serif)', value: 'Playfair Display', category: 'Classic Luxury' },
  { name: 'JetBrains Mono (Tech & Code)', value: 'JetBrains Mono', category: 'Monospace' },
  { name: 'Inter (Clean Minimalist)', value: 'Inter', category: 'Neutral Sans' },
];
---

<div id="subtitle-studio" class="w-full flex flex-col gap-6" data-initial-mode={initialMode}>

  <!-- Notification Toast Container -->
  <div id="studio-toast" class="hidden fixed top-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all flex items-center gap-3">
    <span id="studio-toast-icon" class="text-xl"></span>
    <p id="studio-toast-msg" class="text-sm font-medium"></p>
  </div>

  <!-- ─── 1. UPLOAD VIEW WITH 2 CLEAR OPTIONS / MODES ─── -->
  <div id="studio-upload-view" class="w-full max-w-3xl mx-auto flex flex-col items-center gap-5 transition-all">
    
    <!-- Prominent Mode Switcher Tabs (Option 1: AI Auto-Captions vs Option 2: Burn Existing Subtitles) -->
    <div class="flex items-center p-1.5 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-[var(--color-hairline)] w-full max-w-lg mx-auto shadow-xs">
      <button
        id="mode-tab-ai"
        type="button"
        class="mode-tab-btn flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-2 bg-white dark:bg-zinc-800 text-[var(--color-ink)] shadow-sm"
        data-target-mode="ai"
      >
        <span class="text-base">🎙️</span>
        <span>Auto Subtitles (AI)</span>
      </button>
      
      <button
        id="mode-tab-burn"
        type="button"
        class="mode-tab-btn flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-2 text-[var(--color-mute)] hover:text-[var(--color-ink)]"
        data-target-mode="burn"
      >
        <span class="text-base">🔥</span>
        <span>Burn Subtitles (Video + Subtitle)</span>
      </button>
    </div>

    <!-- ───────────────────────────────────────────────────────── -->
    <!-- OPTION 1: AI AUTO-CAPTION GENERATOR VIEW                  -->
    <!-- ───────────────────────────────────────────────────────── -->
    <div id="view-mode-ai" class="w-full flex flex-col items-center gap-4 transition-all">
      
      <!-- AI Dropzone Card -->
      <label
        id="hero-dropzone"
        for="hero-media-input"
        class="relative w-full border-2 border-dashed border-sky-400/80 hover:border-sky-500 bg-white/70 dark:bg-[#141417]/80 backdrop-blur-md rounded-3xl p-10 md:p-14 text-center cursor-pointer transition-all hover:bg-sky-50/40 dark:hover:bg-sky-950/30 shadow-l2 group flex flex-col items-center justify-center gap-3"
      >
        <div class="w-14 h-14 rounded-2xl bg-white dark:bg-zinc-800 border border-zinc-200/80 dark:border-zinc-700 shadow-sm flex items-center justify-center text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </div>

        <div class="flex flex-col gap-0.5">
          <h3 class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
            Drag & drop your video or audio clip
          </h3>
          <p class="text-xs sm:text-sm text-[var(--color-link)] font-medium">
            or click to browse from device
          </p>
        </div>

        <p class="text-xs text-[var(--color-mute)] max-w-md mt-1 leading-relaxed">
          Video (MP4, MOV, WebM, MKV) or audio (MP3, WAV) · AI auto-transcribes speech · Download .SRT/.VTT or export MP4
        </p>

        <!-- Hidden input for AI mode -->
        <input
          id="hero-media-input"
          type="file"
          accept="video/*,audio/*,.mp4,.mov,.webm,.mkv,.mp3,.wav,.m4a"
          class="sr-only"
        />

        <!-- Transcribe Loading Overlay inside Dropzone -->
        <div id="transcribe-loading-overlay" class="hidden absolute inset-0 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center gap-4 z-20">
          <div class="flex items-center gap-1.5 h-8">
            <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-1 h-6 animate-pulse"></div>
            <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-2 h-8 animate-pulse"></div>
            <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-3 h-4 animate-pulse"></div>
            <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-4 h-7 animate-pulse"></div>
            <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-5 h-5 animate-pulse"></div>
          </div>
          <p id="transcribe-status-text" class="text-sm font-semibold text-[var(--color-ink)] animate-pulse">
            Transcribing speech with Cloudflare Whisper AI…
          </p>
        </div>
      </label>

      <!-- 3 Step Process Cards for AI Auto-Caption -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 mt-1 w-full">
        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/70 dark:bg-[#141417]/80 border border-[var(--color-hairline)] shadow-xs">
          <div class="w-7 h-7 rounded-full bg-sky-100 dark:bg-sky-950/80 text-sky-600 dark:text-sky-400 font-bold text-xs flex items-center justify-center shrink-0">1</div>
          <div class="flex flex-col">
            <span class="text-xs font-bold text-[var(--color-ink)]">1. Upload Clip</span>
            <span class="text-[11px] text-[var(--color-mute)]">Video or Audio file</span>
          </div>
        </div>

        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/70 dark:bg-[#141417]/80 border border-[var(--color-hairline)] shadow-xs">
          <div class="w-7 h-7 rounded-full bg-sky-100 dark:bg-sky-950/80 text-sky-600 dark:text-sky-400 font-bold text-xs flex items-center justify-center shrink-0">2</div>
          <div class="flex flex-col">
            <span class="text-xs font-bold text-[var(--color-ink)]">2. AI Transcribe & Style</span>
            <span class="text-[11px] text-[var(--color-mute)]">Whisper + Viral presets</span>
          </div>
        </div>

        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/70 dark:bg-[#141417]/80 border border-[var(--color-hairline)] shadow-xs">
          <div class="w-7 h-7 rounded-full bg-sky-100 dark:bg-sky-950/80 text-sky-600 dark:text-sky-400 font-bold text-xs flex items-center justify-center shrink-0">3</div>
          <div class="flex flex-col">
            <span class="text-xs font-bold text-[var(--color-ink)]">3. Download / Export</span>
            <span class="text-[11px] text-[var(--color-mute)]">Captioned MP4 or .SRT/.VTT</span>
          </div>
        </div>
      </div>

      <!-- Instant Sample Demos -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-1 text-xs text-[var(--color-mute)]">
        <span>Or try an instant sample:</span>
        <button type="button" class="sample-audio-btn text-xs font-semibold text-[var(--color-link)] hover:underline" data-sample="motivation">🔥 Viral Reel</button>
        <span>·</span>
        <button type="button" class="sample-audio-btn text-xs font-semibold text-[var(--color-link)] hover:underline" data-sample="podcast">🎙️ Tech Podcast</button>
        <span>·</span>
        <button type="button" class="sample-audio-btn text-xs font-semibold text-[var(--color-link)] hover:underline" data-sample="tutorial">⚡ Coding Tutorial</button>
      </div>
    </div>

    <!-- ───────────────────────────────────────────────────────── -->
    <!-- OPTION 2: BURN EXISTING SUBTITLES (VIDEO + SUBTITLE FILE) -->
    <!-- ───────────────────────────────────────────────────────── -->
    <div id="view-mode-burn" class="hidden w-full flex flex-col items-center gap-5 transition-all">
      
      <div class="text-center max-w-xl flex flex-col gap-1">
        <h3 class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          Burn Existing Subtitles into Video
        </h3>
        <p class="text-xs sm:text-sm text-[var(--color-body)]">
          Already have a subtitle file? Upload your video and subtitle file to sync, apply viral animations, and burn directly into high-res MP4!
        </p>
      </div>

      <!-- Dual Dropzone Grid: Video File + Subtitle File -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
        
        <!-- 1. Video File Drop Card -->
        <div
          id="burn-video-dropzone"
          class="relative border-2 border-dashed border-sky-400/70 hover:border-sky-500 bg-white/70 dark:bg-[#141417]/80 backdrop-blur-md rounded-3xl p-6 text-center cursor-pointer transition-all hover:bg-sky-50/40 dark:hover:bg-sky-950/30 shadow-l1 flex flex-col items-center justify-center gap-2 group min-h-[190px]"
        >
          <input
            id="burn-video-input"
            type="file"
            accept="video/*,.mp4,.mov,.webm,.mkv,.avi,.m4v"
            class="sr-only"
          />
          <div class="w-12 h-12 rounded-2xl bg-white dark:bg-zinc-800 border border-zinc-200/80 dark:border-zinc-700 shadow-xs flex items-center justify-center text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform">
            <span class="text-2xl">🎬</span>
          </div>

          <div class="flex flex-col gap-0.5">
            <span class="text-sm font-bold text-[var(--color-ink)]">1. Select Video File</span>
            <span class="text-xs text-[var(--color-link)] font-medium">MP4, MOV, WebM, MKV</span>
          </div>

          <div id="burn-video-selected-badge" class="hidden mt-1 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 text-xs font-mono font-medium max-w-[90%] truncate">
            ✓ Video chosen
          </div>
          <p id="burn-video-empty-text" class="text-[11px] text-[var(--color-mute)]">Drop video or click to browse</p>
        </div>

        <!-- 2. Subtitle File Drop Card -->
        <div
          id="burn-sub-dropzone"
          class="relative border-2 border-dashed border-amber-400/70 hover:border-amber-500 bg-white/70 dark:bg-[#141417]/80 backdrop-blur-md rounded-3xl p-6 text-center cursor-pointer transition-all hover:bg-amber-50/40 dark:hover:bg-amber-950/30 shadow-l1 flex flex-col items-center justify-center gap-2 group min-h-[190px]"
        >
          <input
            id="burn-sub-input"
            type="file"
            accept=".srt,.vtt,.ass,.ssa,.sub,.sbv,.json,.txt"
            class="sr-only"
          />
          <div class="w-12 h-12 rounded-2xl bg-white dark:bg-zinc-800 border border-zinc-200/80 dark:border-zinc-700 shadow-xs flex items-center justify-center text-amber-600 dark:text-amber-400 group-hover:scale-110 transition-transform">
            <span class="text-2xl">📄</span>
          </div>

          <div class="flex flex-col gap-0.5">
            <span class="text-sm font-bold text-[var(--color-ink)]">2. Select Subtitle File</span>
            <span class="text-xs text-amber-600 dark:text-amber-400 font-medium">.SRT, .VTT, .ASS, .SUB, .JSON</span>
          </div>

          <div id="burn-sub-selected-badge" class="hidden mt-1 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 text-xs font-mono font-medium max-w-[90%] truncate">
            ✓ Subtitle chosen
          </div>
          <p id="burn-sub-empty-text" class="text-[11px] text-[var(--color-mute)]">Drop .SRT/.VTT or click to browse</p>
        </div>

      </div>

      <!-- Quick Dual Drop Helper Note -->
      <p class="text-center text-xs text-[var(--color-mute)]">
        💡 <strong>Quick tip:</strong> You can select or drag <em>both files together</em> into either box above!
      </p>

      <!-- Launch Burner Button -->
      <div class="flex flex-col sm:flex-row items-center gap-3 w-full justify-center">
        <button
          id="burn-launch-btn"
          type="button"
          class="w-full sm:w-auto px-8 py-3.5 rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] font-bold text-sm hover:opacity-90 transition-all shadow-l2 flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>🔥</span>
          <span>Open Studio & Burn Subtitles into Video →</span>
        </button>

        <button
          id="burn-sample-pair-btn"
          type="button"
          class="w-full sm:w-auto px-5 py-3.5 rounded-pill border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] font-semibold text-xs hover:bg-[var(--color-canvas-soft)] transition-all shadow-xs"
        >
          <span>✨</span>
          <span>Try Sample Video + Subtitles</span>
        </button>
      </div>

      <!-- 3 Step Process Cards for Burn Mode -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 mt-2 w-full">
        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/70 dark:bg-[#141417]/80 border border-[var(--color-hairline)] shadow-xs">
          <div class="w-7 h-7 rounded-full bg-amber-100 dark:bg-amber-950/80 text-amber-600 dark:text-amber-400 font-bold text-xs flex items-center justify-center shrink-0">1</div>
          <div class="flex flex-col">
            <span class="text-xs font-bold text-[var(--color-ink)]">1. Upload Both</span>
            <span class="text-[11px] text-[var(--color-mute)]">Video + Subtitle file</span>
          </div>
        </div>

        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/70 dark:bg-[#141417]/80 border border-[var(--color-hairline)] shadow-xs">
          <div class="w-7 h-7 rounded-full bg-amber-100 dark:bg-amber-950/80 text-amber-600 dark:text-amber-400 font-bold text-xs flex items-center justify-center shrink-0">2</div>
          <div class="flex flex-col">
            <span class="text-xs font-bold text-[var(--color-ink)]">2. Style & Timing Sync</span>
            <span class="text-[11px] text-[var(--color-mute)]">Hormozi, MrBeast & offset</span>
          </div>
        </div>

        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/70 dark:bg-[#141417]/80 border border-[var(--color-hairline)] shadow-xs">
          <div class="w-7 h-7 rounded-full bg-amber-100 dark:bg-amber-950/80 text-amber-600 dark:text-amber-400 font-bold text-xs flex items-center justify-center shrink-0">3</div>
          <div class="flex flex-col">
            <span class="text-xs font-bold text-[var(--color-ink)]">3. Export MP4</span>
            <span class="text-[11px] text-[var(--color-mute)]">Zero watermark burned MP4</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom note -->
    <p class="text-center text-xs text-[var(--color-mute)] pt-2">
      Editing in Premiere Pro or CapCut? <a href="/subtitle-styles" class="text-[var(--color-ink)] font-semibold underline hover:text-[var(--color-link)] transition-colors">Explore viral caption styles</a> for your timeline.
    </p>

  </div>

  <!-- ─── 2. STUDIO EDITOR VIEW (Unified for both AI Generated & Uploaded Subtitles) ─── -->
  <div id="studio-editor-view" class="hidden w-full bg-[var(--color-canvas)] rounded-3xl border border-[var(--color-hairline)] shadow-l3 overflow-hidden flex-col gap-6 p-6 md:p-8 transition-all">
    
    <!-- Top Action Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[var(--color-hairline)]">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <button
          id="back-to-upload-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] hover:border-[var(--color-hairline-strong)] transition-all"
        >
          <span>←</span>
          <span>Upload Another</span>
        </button>
        
        <span id="current-file-badge" class="px-3 py-1 text-xs font-mono font-medium rounded-full bg-[var(--color-link-bg-soft)] text-[var(--color-link)] max-w-[180px] truncate" title="Current Video">
          ✓ demo-video.mp4
        </span>

        <span id="current-sub-badge" class="px-3 py-1 text-xs font-mono font-medium rounded-full bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 max-w-[180px] truncate" title="Current Subtitles">
          ✓ 4 subtitle cues
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <!-- Load or replace subtitle file -->
        <label for="studio-load-sub-input" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full border border-amber-500/50 bg-amber-50/50 dark:bg-amber-950/30 text-amber-900 dark:text-amber-200 hover:bg-amber-100/60 cursor-pointer transition-all shadow-xs">
          <span>📄</span>
          <span>Import Subtitle File (.SRT/.VTT)</span>
          <input id="studio-load-sub-input" type="file" accept=".srt,.vtt,.ass,.ssa,.sub,.sbv,.json,.txt" class="sr-only" />
        </label>

        <!-- Replace Video -->
        <label for="studio-replace-file-input" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] cursor-pointer transition-all shadow-xs">
          <span>🎬</span>
          <span>Change Video</span>
          <input id="studio-replace-file-input" type="file" accept="video/*,audio/*,.mp4,.mov,.webm,.mkv,.mp3,.wav,.m4a" class="sr-only" />
        </label>

        <!-- Re-transcribe with AI -->
        <button
          id="editor-whisper-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold rounded-full bg-[var(--color-link)] text-white hover:opacity-90 transition-all shadow-xs"
        >
          <span>⚡</span>
          <span>AI Re-Transcribe</span>
        </button>
      </div>
    </div>

    <!-- Studio Grid: Video Player + Controls -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left Column: Video Preview Player & Controls -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        
        <!-- Video Options Bar (Aspect Ratio + Fit Mode) -->
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-1 p-1 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs">
            <button class="aspect-btn px-2.5 py-1 rounded-lg font-medium text-[var(--color-ink)] bg-[var(--color-canvas)] shadow-xs transition-all" data-aspect="original" title="Original Aspect Ratio">
              🎯 Auto
            </button>
            <button class="aspect-btn px-2.5 py-1 rounded-lg font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="9:16">
              9:16
            </button>
            <button class="aspect-btn px-2.5 py-1 rounded-lg font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="16:9">
              16:9
            </button>
            <button class="aspect-btn px-2.5 py-1 rounded-lg font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="1:1">
              1:1
            </button>
          </div>

          <div class="flex items-center gap-2">
            <button id="video-fit-btn" type="button" class="px-2.5 py-1 text-xs font-semibold rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] shadow-xs transition-all">
              Fit (100% View)
            </button>
          </div>
        </div>

        <!-- Video Canvas Container -->
        <div id="video-preview-wrapper" class="relative w-full max-h-[500px] aspect-[16/9] mx-auto bg-black rounded-2xl overflow-hidden shadow-l3 border border-[var(--color-hairline)] flex items-center justify-center group select-none transition-all duration-300">
          
          <!-- Native Video Element -->
          <video
            id="studio-video"
