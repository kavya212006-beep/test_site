---
import { t } from '../../i18n/utils';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const stylePresets = [
  { id: 'hormozi', nameKey: 'styles.hormozi', icon: '🔥', font: 'Outfit', color: '#ffffff', highlight: '#facc15', stroke: 0, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Bold yellow pop, high-energy viral retention' },
  { id: 'beast', nameKey: 'styles.beast', icon: '⚡', font: 'Syne', color: '#ffffff', highlight: '#38bdf8', stroke: 2, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Thick black stroke with cyan bounce' },
  { id: 'cinematic', nameKey: 'styles.cinematic', icon: '🎬', font: 'Inter', color: '#ffffff', highlight: '#60a5fa', stroke: 0, shadow: false, bg: 'frosted', transform: 'none', desc: 'Frosted dark pill box for film & docs' },
  { id: 'neon', nameKey: 'styles.neon', icon: '💜', font: 'Space Grotesk', color: '#ffffff', highlight: '#ff0080', stroke: 0, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Cyberpunk glowing cyan & pink neon' },
  { id: 'bangers', nameKey: 'styles.bangers', icon: '💥', font: 'Bangers', color: '#facc15', highlight: '#ff0055', stroke: 2, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Comic action pop with heavy stroke' },
  { id: 'marker', nameKey: 'styles.marker', icon: '✍️', font: 'Permanent Marker', color: '#ffffff', highlight: '#a855f7', stroke: 0, shadow: true, bg: 'none', transform: 'none', desc: 'Urban handwritten graffiti style' },
  { id: 'bebas', nameKey: 'styles.bebas', icon: '🚀', font: 'Bebas Neue', color: '#ffffff', highlight: '#fb923c', stroke: 0, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Tall condensed viral headline punch' },
  { id: 'karaoke', nameKey: 'styles.karaoke', icon: '🎤', font: 'Outfit', color: 'rgba(255,255,255,0.7)', highlight: '#4ade80', stroke: 0, shadow: true, bg: 'none', transform: 'none', desc: 'Smooth progressive green highlight' },
  { id: 'minimal', nameKey: 'styles.minimal', icon: '✨', font: 'Inter', color: '#ffffff', highlight: '#ffffff', stroke: 0, shadow: false, bg: 'none', transform: 'none', desc: 'Clean modern typography' },
];

const fontFamilies = [
  { name: 'Outfit (Viral Standard)', value: 'Outfit', category: 'Modern Geometric Sans' },
  { name: 'Anton (Ultra Bold Impact)', value: 'Anton', category: 'Headline Bold' },
  { name: 'Montserrat (Heavy Black 900)', value: 'Montserrat', category: 'Bold Punch' },
  { name: 'Bebas Neue (Tall Condensed)', value: 'Bebas Neue', category: 'Cinematic Hook' },
  { name: 'Syne (High-Energy Punch)', value: 'Syne', category: 'Trendy Viral' },
  { name: 'Bangers (Comic Action / Beast)', value: 'Bangers', category: 'Comic Cartoon' },
  { name: 'Luckiest Guy (Playful Bold)', value: 'Luckiest Guy', category: 'Playful Punch' },
  { name: 'Permanent Marker (Graffiti / Urban)', value: 'Permanent Marker', category: 'Handwritten' },
  { name: 'Space Grotesk (Cyberpunk Neon)', value: 'Space Grotesk', category: 'Futuristic' },
  { name: 'Cinzel (Epic Cinematic)', value: 'Cinzel', category: 'Luxury Film' },
  { name: 'Playfair Display (Editorial Serif)', value: 'Playfair Display', category: 'Classic Luxury' },
  { name: 'JetBrains Mono (Tech & Code)', value: 'JetBrains Mono', category: 'Monospace' },
  { name: 'Inter (Clean Minimalist)', value: 'Inter', category: 'Neutral Sans' },
];
---

<div id="subtitle-studio" class="w-full flex flex-col gap-6">

  <!-- Notification Toast Container -->
  <div id="studio-toast" class="hidden fixed top-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all flex items-center gap-3">
    <span id="studio-toast-icon" class="text-xl"></span>
    <p id="studio-toast-msg" class="text-sm font-medium"></p>
  </div>

  <!-- ─── 1. CLEAN HERO UPLOAD VIEW (Exact match to reference design) ─── -->
  <div id="studio-upload-view" class="w-full max-w-3xl mx-auto flex flex-col items-center gap-4 transition-all">
    
    <!-- Hero Dropzone Card -->
    <label
      id="hero-dropzone"
      for="hero-media-input"
      class="relative w-full border-2 border-dashed border-sky-400/80 hover:border-sky-500 bg-white/70 dark:bg-[#141417]/80 backdrop-blur-md rounded-3xl p-10 md:p-14 text-center cursor-pointer transition-all hover:bg-sky-50/40 dark:hover:bg-sky-950/30 shadow-l2 group flex flex-col items-center justify-center gap-3"
    >
      <!-- Upload Icon inside clean squircle -->
      <div class="w-14 h-14 rounded-2xl bg-white dark:bg-zinc-800 border border-zinc-200/80 dark:border-zinc-700 shadow-sm flex items-center justify-center text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>

      <!-- Main Headline & Subtitle -->
      <div class="flex flex-col gap-0.5">
        <h3 class="text-base sm:text-lg font-bold text-[var(--color-ink)]">
          Drag & drop your video or song
        </h3>
        <p class="text-xs sm:text-sm text-[var(--color-link)] font-medium">
          or click to browse
        </p>
      </div>

      <!-- Format constraints note -->
      <p class="text-xs text-[var(--color-mute)] max-w-md mt-1 leading-relaxed">
        Video (MP4, MOV, WebM) or audio (MP3, WAV) · up to 10 min · under 2 GB · stays on your device
      </p>

      <!-- Hidden Input for file browsing -->
      <input
        id="hero-media-input"
        type="file"
        accept="video/*,audio/*,.mp4,.mov,.webm,.mkv,.mp3,.wav,.m4a,.srt,.vtt,.ass"
        class="sr-only"
      />

      <!-- Transcribe Loading Overlay inside Dropzone -->
      <div id="transcribe-loading-overlay" class="hidden absolute inset-0 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center gap-4 z-20">
        <div class="flex items-center gap-1.5 h-8">
          <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-1 h-6 animate-pulse"></div>
          <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-2 h-8 animate-pulse"></div>
          <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-3 h-4 animate-pulse"></div>
          <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-4 h-7 animate-pulse"></div>
          <div class="w-1.5 bg-sky-500 rounded-full waveform-bar-5 h-5 animate-pulse"></div>
        </div>
        <p id="transcribe-status-text" class="text-sm font-semibold text-[var(--color-ink)] animate-pulse">
          Transcribing speech with AI…
        </p>
      </div>
    </label>

    <!-- 3 Step Process Cards (Clean horizontal row below dropzone) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 mt-2 w-full">
      <!-- Step 1 -->
      <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/70 dark:bg-[#141417]/80 border border-[var(--color-hairline)] shadow-xs">
        <div class="w-7 h-7 rounded-full bg-sky-100 dark:bg-sky-950/80 text-sky-600 dark:text-sky-400 font-bold text-xs flex items-center justify-center shrink-0">
          1
        </div>
        <div class="flex flex-col">
          <span class="text-xs font-bold text-[var(--color-ink)]">Upload</span>
          <span class="text-[11px] text-[var(--color-mute)]">Your clip</span>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/70 dark:bg-[#141417]/80 border border-[var(--color-hairline)] shadow-xs">
        <div class="w-7 h-7 rounded-full bg-sky-100 dark:bg-sky-950/80 text-sky-600 dark:text-sky-400 font-bold text-xs flex items-center justify-center shrink-0">
          2
        </div>
        <div class="flex flex-col">
          <span class="text-xs font-bold text-[var(--color-ink)]">Edit & style</span>
          <span class="text-[11px] text-[var(--color-mute)]">Review + template</span>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/70 dark:bg-[#141417]/80 border border-[var(--color-hairline)] shadow-xs">
        <div class="w-7 h-7 rounded-full bg-sky-100 dark:bg-sky-950/80 text-sky-600 dark:text-sky-400 font-bold text-xs flex items-center justify-center shrink-0">
          3
        </div>
        <div class="flex flex-col">
          <span class="text-xs font-bold text-[var(--color-ink)]">Export</span>
          <span class="text-[11px] text-[var(--color-mute)]">Captioned MP4</span>
        </div>
      </div>
    </div>

    <!-- Instant Sample Demos -->
    <div class="flex flex-wrap items-center justify-center gap-2 pt-2 text-xs text-[var(--color-mute)]">
      <span>Or try an instant sample:</span>
      <button type="button" class="sample-audio-btn text-xs font-semibold text-[var(--color-link)] hover:underline" data-sample="motivation">🔥 Viral Reel</button>
      <span>·</span>
      <button type="button" class="sample-audio-btn text-xs font-semibold text-[var(--color-link)] hover:underline" data-sample="podcast">🎙️ Tech Podcast</button>
      <span>·</span>
      <button type="button" class="sample-audio-btn text-xs font-semibold text-[var(--color-link)] hover:underline" data-sample="tutorial">⚡ Coding Tutorial</button>
    </div>

    <!-- Bottom note -->
    <p class="text-center text-xs text-[var(--color-mute)] pt-2">
      Editing in Premiere Pro? <a href="/subtitle-styles" class="text-[var(--color-ink)] font-semibold underline hover:text-[var(--color-link)] transition-colors">Explore viral caption styles</a> for your timeline.
    </p>

  </div>

  <!-- ─── 2. STUDIO EDITOR VIEW (Revealed after upload or sample selection) ─── -->
  <div id="studio-editor-view" class="hidden w-full bg-[var(--color-canvas)] rounded-3xl border border-[var(--color-hairline)] shadow-l3 overflow-hidden flex-col gap-6 p-6 md:p-8 transition-all">
    
    <!-- Top Action Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[var(--color-hairline)]">
      <div class="flex items-center gap-3">
        <button
          id="back-to-upload-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] hover:border-[var(--color-hairline-strong)] transition-all"
        >
          <span>←</span>
          <span>Upload Another Video</span>
        </button>
        <span id="current-file-badge" class="px-3 py-1 text-xs font-mono font-medium rounded-full bg-[var(--color-link-bg-soft)] text-[var(--color-link)] max-w-[200px] truncate">
          ✓ demo-video.mp4
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button
          id="editor-whisper-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold rounded-full bg-[var(--color-link)] text-white hover:opacity-90 transition-all shadow-xs"
        >
          <span>⚡</span>
          <span>Auto-Transcribe with Whisper</span>
        </button>

        <label for="studio-replace-file-input" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft)] cursor-pointer transition-all shadow-xs">
          <span>📁</span>
          <span>Change Media</span>
          <input id="studio-replace-file-input" type="file" accept="video/*,audio/*,.mp4,.mov,.webm,.mkv,.mp3,.wav,.m4a,.srt,.vtt,.ass" class="sr-only" />
        </label>
      </div>
    </div>

    <!-- Studio Grid: Video Player + Controls -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left Column: Video Preview Player & Controls -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        
        <!-- Video Options Bar (Aspect Ratio + Fit Mode) -->
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-1 p-1 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs">
            <button class="aspect-btn px-2.5 py-1 rounded-lg font-medium text-[var(--color-ink)] bg-[var(--color-canvas)] shadow-xs transition-all" data-aspect="original" title="Original Aspect Ratio">
              🎯 Auto
            </button>
            <button class="aspect-btn px-2.5 py-1 rounded-lg font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="9:16">
              9:16
            </button>
            <button class="aspect-btn px-2.5 py-1 rounded-lg font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="16:9">
              16:9
            </button>
            <button class="aspect-btn px-2.5 py-1 rounded-lg font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="1:1">
              1:1
            </button>
          </div>

          <div class="flex items-center gap-2">
            <button id="video-fit-btn" type="button" class="px-2.5 py-1 text-xs font-semibold rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] shadow-xs transition-all">
              Fit (100% View)
            </button>
          </div>
        </div>

        <!-- Video Canvas Container -->
        <div id="video-preview-wrapper" class="relative w-full max-h-[500px] aspect-[16/9] mx-auto bg-black rounded-2xl overflow-hidden shadow-l3 border border-[var(--color-hairline)] flex items-center justify-center group select-none transition-all duration-300">
          
          <!-- Native Video Element -->
          <video
            id="studio-video"
            class="w-full h-full object-contain max-h-[500px] block"
            playsinline
            preload="auto"
            crossorigin="anonymous"
          ></video>

          <!-- Canvas for subtitle rendering and video export -->
          <canvas id="studio-burn-canvas" class="hidden"></canvas>

          <!-- Social Media Safe Zone Overlays -->
          <div id="safe-zone-tiktok" class="hidden absolute inset-0 pointer-events-none border-2 border-dashed border-red-400/40 m-4 flex flex-col justify-between p-3 z-10">
            <div class="text-[10px] font-mono text-red-300/80 bg-black/60 px-1.5 py-0.5 rounded self-start">TikTok Safe Top</div>
            <div class="text-[10px] font-mono text-red-300/80 bg-black/60 px-1.5 py-0.5 rounded self-end">TikTok UI</div>
            <div class="text-[10px] font-mono text-red-300/80 bg-black/60 px-1.5 py-0.5 rounded self-start">Caption Bounds</div>
          </div>

          <div id="safe-zone-reels" class="hidden absolute inset-0 pointer-events-none border-2 border-dashed border-purple-400/40 m-4 flex flex-col justify-between p-3 z-10">
            <div class="text-[10px] font-mono text-purple-300/80 bg-black/60 px-1.5 py-0.5 rounded self-start">Reels Top Safe</div>
            <div class="text-[10px] font-mono text-purple-300/80 bg-black/60 px-1.5 py-0.5 rounded self-end">Reels Icons</div>
            <div class="text-[10px] font-mono text-purple-300/80 bg-black/60 px-1.5 py-0.5 rounded self-start">Audio Label Safe</div>
          </div>

          <!-- Live Subtitle Overlay Layer with Dynamic Styles -->
          <div id="subtitle-overlay" class="absolute inset-x-0 bottom-16 flex flex-col items-center justify-center p-4 pointer-events-none z-10 text-center transition-all">
            <div id="subtitle-render-box" class="sub-style-hormozi font-extrabold text-2xl tracking-tight transition-all duration-75 inline-block text-center max-w-[90%]">
              <span class="inline-block mx-1">AutoCaption</span>
              <span class="inline-block mx-1 word-active">Generator</span>
            </div>
          </div>

          <!-- Custom Play/Pause Overlay Button -->
          <button
            id="video-play-btn"
            type="button"
            class="absolute inset-0 flex items-center justify-center bg-black/30 hover:bg-black/20 text-white text-4xl transition-all cursor-pointer z-10"
            aria-label="Play video"
          >
            <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/30 shadow-l2 group-hover:scale-110 transition-transform">
              ▶
            </div>
          </button>
        </div>

        <!-- Video Playback & Seek Bar -->
        <div class="flex items-center gap-3 p-3 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
          <button id="ctrl-play-pause" type="button" class="p-2 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] transition-colors" aria-label="Play/Pause">
            ▶
          </button>
          <input
            id="ctrl-seekbar"
            type="range"
            min="0"
            max="100"
            value="0"
            step="0.1"
            class="flex-1 accent-[var(--color-link)] cursor-pointer"
          />
          <span id="ctrl-time-display" class="text-xs font-mono text-[var(--color-body)] min-w-[75px] text-right">
            00:00 / 00:00
          </span>
        </div>

        <!-- Video Position & Safe Zone Settings -->
        <div class="grid grid-cols-2 gap-3 p-3 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs">
          <div class="flex flex-col gap-1">
            <span class="font-medium text-[var(--color-body)]">Social Safe Zones:</span>
            <select id="safezone-select" class="p-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] text-xs">
              <option value="none">None (Full View)</option>
              <option value="tiktok">TikTok / Shorts Overlay</option>
              <option value="reels">Instagram Reels Overlay</option>
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <span class="font-medium text-[var(--color-body)]">Caption Position:</span>
            <select id="position-select" class="p-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] text-xs">
              <option value="bottom">Bottom (80%) - Standard</option>
              <option value="center">Center - High Focus</option>
              <option value="top">Top (20%) - Title Hook</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Right Column: Style Presets, Typography, Timing Sync & Subtitles Timeline -->
      <div class="lg:col-span-5 flex flex-col gap-5">
        
        <!-- Style Presets Grid -->
        <div class="flex flex-col gap-3 p-4 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
          <div class="flex items-center justify-between pb-2 border-b border-[var(--color-hairline)]">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-ink)]">Trending Styles</span>
            <span class="text-[11px] text-[var(--color-mute)] font-medium">Click to apply</span>
          </div>
          
          <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
            {stylePresets.map(preset => (
              <button
                type="button"
                class="style-preset-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] hover:border-[var(--color-link)] hover:shadow-xs transition-all text-center gap-1 group relative"
                data-preset={preset.id}
                data-font={preset.font}
                data-color={preset.color}
                data-highlight={preset.highlight}
                data-stroke={preset.stroke}
                data-bg={preset.bg}
                data-transform={preset.transform}
                title={preset.desc}
              >
                <span class="text-lg group-hover:scale-110 transition-transform">{preset.icon}</span>
                <span class="text-[11px] font-bold text-[var(--color-ink)] leading-tight">{t(lang, preset.nameKey as any)}</span>
              </button>
            ))}
          </div>

          <!-- Typography Customizer Accordion -->
          <details id="custom-font-details" class="group pt-2 border-t border-[var(--color-hairline)]">
            <summary class="flex items-center justify-between cursor-pointer list-none text-xs font-bold text-[var(--color-ink)] hover:text-[var(--color-link)] transition-colors py-1">
              <span class="flex items-center gap-1.5">
                <span>🎨</span>
                <span>Customize Fonts & Colors</span>
              </span>
              <span class="text-[10px] text-[var(--color-mute)] group-open:rotate-180 transition-transform">▼</span>
            </summary>

            <div class="flex flex-col gap-3 pt-3">
              <!-- Font Family -->
              <div class="flex flex-col gap-1">
                <label for="font-family-select" class="text-[11px] font-semibold text-[var(--color-mute)] uppercase tracking-wider flex items-center justify-between">
                  <span>Font Family:</span>
                  <span id="current-font-badge" class="text-[10px] font-mono text-[var(--color-link)] font-bold">Outfit</span>
                </label>
                <select
                  id="font-family-select"
                  class="w-full p-2 text-xs font-semibold rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-link)] cursor-pointer shadow-xs transition-all"
                >
                  {fontFamilies.map(f => (
                    <option value={f.value}>{f.name} — {f.category}</option>
                  ))}
                </select>
              </div>

              <!-- Font Size -->
              <div class="flex flex-col gap-1">
                <div class="flex items-center justify-between text-[11px]">
                  <span class="font-semibold text-[var(--color-mute)] uppercase tracking-wider">Font Size:</span>
                  <span id="font-size-val" class="font-bold font-mono text-[var(--color-ink)]">28px</span>
                </div>
                <div class="flex items-center gap-2">
                  <input
                    id="font-size-slider"
                    type="range"
                    min="18"
                    max="54"
                    value="28"
                    class="flex-1 accent-[var(--color-link)] cursor-pointer"
                  />
                  <div class="flex items-center gap-1">
                    <button type="button" class="quick-size-btn px-2 py-0.5 text-[10px] font-bold rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)]" data-size="22">S</button>
                    <button type="button" class="quick-size-btn px-2 py-0.5 text-[10px] font-bold rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)]" data-size="30">M</button>
                    <button type="button" class="quick-size-btn px-2 py-0.5 text-[10px] font-bold rounded border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)]" data-size="38">L</button>
                  </div>
                </div>
              </div>

              <!-- Colors -->
              <div class="grid grid-cols-2 gap-3">
                <div class="flex flex-col gap-1.5">
                  <label class="text-[11px] font-semibold text-[var(--color-mute)] uppercase tracking-wider">Base Text:</label>
                  <div class="flex items-center gap-2">
                    <input id="base-color-picker" type="color" value="#ffffff" class="w-7 h-7 rounded-lg border border-[var(--color-hairline)] cursor-pointer p-0 bg-transparent" />
                    <div class="flex items-center gap-1">
                      <button type="button" class="quick-base-color w-4 h-4 rounded-full bg-white border border-zinc-400 shadow-xs" data-color="#ffffff" title="White"></button>
                      <button type="button" class="quick-base-color w-4 h-4 rounded-full bg-yellow-400 shadow-xs" data-color="#facc15" title="Yellow"></button>
                      <button type="button" class="quick-base-color w-4 h-4 rounded-full bg-zinc-900 shadow-xs" data-color="#18181b" title="Dark"></button>
                    </div>
                  </div>
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-[11px] font-semibold text-[var(--color-mute)] uppercase tracking-wider">Active Highlight:</label>
                  <div class="flex items-center gap-2">
                    <input id="highlight-color-picker" type="color" value="#facc15" class="w-7 h-7 rounded-lg border border-[var(--color-hairline)] cursor-pointer p-0 bg-transparent" />
                    <div class="flex items-center gap-1">
                      <button type="button" class="quick-high-color w-4 h-4 rounded-full bg-yellow-400 shadow-xs" data-color="#facc15" title="Yellow"></button>
                      <button type="button" class="quick-high-color w-4 h-4 rounded-full bg-cyan-400 shadow-xs" data-color="#38bdf8" title="Cyan"></button>
                      <button type="button" class="quick-high-color w-4 h-4 rounded-full bg-pink-500 shadow-xs" data-color="#ff0080" title="Pink"></button>
                      <button type="button" class="quick-high-color w-4 h-4 rounded-full bg-emerald-400 shadow-xs" data-color="#4ade80" title="Green"></button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Stroke & Backdrop Box -->
              <div class="grid grid-cols-2 gap-3">
                <div class="flex flex-col gap-1">
                  <label class="text-[11px] font-semibold text-[var(--color-mute)] uppercase tracking-wider">Outline Stroke:</label>
                  <select id="stroke-width-select" class="p-1.5 text-xs rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)]">
                    <option value="0">None (0px)</option>
                    <option value="2">Thin (2px)</option>
                    <option value="4">Bold (4px)</option>
                    <option value="6">Thick (6px)</option>
                  </select>
                </div>

                <div class="flex flex-col gap-1">
                  <label class="text-[11px] font-semibold text-[var(--color-mute)] uppercase tracking-wider">Backdrop Box:</label>
                  <select id="backdrop-box-select" class="p-1.5 text-xs rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)]">
                    <option value="none">None (Transparent)</option>
                    <option value="frosted">Frosted Dark Pill</option>
                    <option value="solid-black">Solid Black Box</option>
                    <option value="yellow-box">Yellow Highlight Box</option>
                  </select>
                </div>
              </div>

              <!-- Letter Case -->
              <div class="flex flex-col gap-1">
                <label class="text-[11px] font-semibold text-[var(--color-mute)] uppercase tracking-wider">Letter Case:</label>
                <select id="text-case-select" class="p-1.5 text-xs rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)]">
                  <option value="uppercase">UPPERCASE (Viral)</option>
                  <option value="none">Normal Case</option>
                  <option value="capitalize">Capitalize Words</option>
                </select>
              </div>

            </div>
          </details>
        </div>

        <!-- Millisecond Precision Timing Sync -->
        <div class="flex flex-col gap-3 p-4 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-ink)]">Timing Sync & Drift Fix</span>
            <span id="sync-offset-display" class="text-xs font-mono font-bold text-[var(--color-link)]">+0.00s</span>
          </div>

          <div class="flex items-center gap-2">
            <button id="sync-minus-btn" type="button" class="px-3 py-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs font-bold hover:bg-[var(--color-canvas-soft-2)]">
              -0.2s
            </button>
            <input
              id="sync-offset-slider"
              type="range"
              min="-5"
              max="5"
              step="0.05"
              value="0"
              class="flex-1 accent-[var(--color-link)] cursor-pointer"
            />
            <button id="sync-plus-btn" type="button" class="px-3 py-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs font-bold hover:bg-[var(--color-canvas-soft-2)]">
              +0.2s
            </button>
            <button id="sync-reset-btn" type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)]">
              Reset
            </button>
          </div>
        </div>

        <!-- Subtitle Cues Timeline & Editor -->
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-ink)]">Subtitle Cues Timeline</span>
              <span id="cue-count-badge" class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-[var(--color-canvas-soft-2)] text-[var(--color-ink)]">4 cues</span>
            </div>
            <button id="add-cue-btn" type="button" class="text-xs font-semibold text-[var(--color-link)] hover:underline">
              + Add Cue
            </button>
          </div>

          <!-- Scrollable Cues List -->
          <div id="cues-container" class="flex flex-col gap-2 max-h-[220px] overflow-y-auto pr-1">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Export & Download Actions -->
        <div class="flex flex-col gap-3 pt-2 border-t border-[var(--color-hairline)]">
          <button
            id="export-burned-video-btn"
            type="button"
            class="w-full py-3.5 px-6 rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] font-bold text-sm hover:opacity-90 transition-all shadow-l2 flex items-center justify-center gap-2"
          >
            <span>🎬</span>
            <span>Export High-Res MP4 (Burned Subtitles)</span>
          </button>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <button id="export-srt-btn" type="button" class="p-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] text-[var(--color-ink)] font-semibold transition-colors text-center">
              ⬇️ .SRT
            </button>
            <button id="export-vtt-btn" type="button" class="p-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] text-[var(--color-ink)] font-semibold transition-colors text-center">
              ⬇️ .VTT
            </button>
            <button id="export-ass-btn" type="button" class="p-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] text-[var(--color-ink)] font-semibold transition-colors text-center">
              ⬇️ .ASS
            </button>
            <button id="export-copy-btn" type="button" class="p-2 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] text-[var(--color-ink)] font-semibold transition-colors text-center">
              📋 Copy
            </button>
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- ─── 3. FEEDBACK MODAL ─── -->
  <dialog id="feedback-modal" class="p-0 rounded-3xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm max-w-md w-full">
    <div class="p-6 flex flex-col gap-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-xl">💬</span>
          <h3 class="text-base font-bold text-[var(--color-ink)]">Share Feedback</h3>
        </div>
        <button id="close-feedback-modal-btn" type="button" class="text-[var(--color-mute)] hover:text-[var(--color-ink)] text-lg">✕</button>
      </div>
      <p class="text-xs text-[var(--color-body)] leading-relaxed">
        Help us make FreeAutoCaption even better! Tell us what features or subtitle styles you'd love to see.
      </p>
      <textarea id="feedback-text" rows="4" placeholder="Your suggestions, feedback, or style requests..." class="w-full p-3 rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-sm text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-link)]"></textarea>
      <button id="submit-feedback-btn" type="button" class="w-full py-2.5 rounded-full bg-[var(--color-ink)] text-[var(--color-on-primary)] font-semibold text-xs hover:opacity-90 transition-all">
        Send Feedback
      </button>
    </div>
  </dialog>

  <!-- ─── 4. FLOATING CHAT / FEEDBACK BUBBLE (Bottom Right matching screenshot) ─── -->
  <button
    id="floating-chat-btn"
    type="button"
    class="fixed bottom-6 right-6 z-40 w-12 h-12 rounded-full bg-[#0070f3] hover:bg-[#0060df] text-white flex items-center justify-center shadow-lg hover:scale-105 transition-all focus:outline-none"
    aria-label="Feedback and help"
    title="Have feedback or need help?"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>

</div>

<!-- Subtitle Studio Logic & Engine -->
<script>
  import { parseSubtitleText, parseWhisperResponse, serializeToSRT, serializeToVTT, serializeToASS, serializeToTXT, shiftSubtitleTimings, type SubtitleCue } from '../../utils/subtitleParser';
  import { extractAudioFromMedia } from '../../utils/audioExtractor';

  let currentCues: SubtitleCue[] = [];
  let originalCues: SubtitleCue[] = [];
  let currentPreset = 'hormozi';
  let syncOffset = 0;
  let videoBlobUrl = '';
  let activeVideoFile: File | null = null;

  // Custom Typography State
  const typoState = {
    fontFamily: 'Outfit',
    fontSize: 28,
    baseColor: '#ffffff',
    highlightColor: '#facc15',
    strokeWidth: 0,
    backdropBox: 'none',
    textCase: 'uppercase',
    animMode: 'bounce',
    shadow: true,
  };

  // Toast Notification System
  function showToast(msg: string, type: 'success' | 'warning' | 'info' = 'info') {
    const toast = document.getElementById('studio-toast');
    const toastIcon = document.getElementById('studio-toast-icon');
    const toastMsg = document.getElementById('studio-toast-msg');
    if (!toast || !toastMsg || !toastIcon) return;

    toastIcon.textContent = type === 'success' ? '✓' : type === 'warning' ? '⚠️' : 'ℹ️';
    toastMsg.textContent = msg;

    toast.className = 'fixed top-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all flex items-center gap-3 ' +
      (type === 'success' ? 'bg-emerald-950/90 text-emerald-200 border-emerald-700 backdrop-blur-md' :
       type === 'warning' ? 'bg-amber-950/90 text-amber-200 border-amber-700 backdrop-blur-md' :
       'bg-[var(--color-canvas)] text-[var(--color-ink)] border-[var(--color-hairline)] backdrop-blur-md');

    toast.classList.remove('hidden');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 4500);
  }

  // Default demo cues
  const defaultDemoCues: SubtitleCue[] = [
    { id: 1, start: 0.0, end: 2.4, text: "Stop wasting hours typing subtitles manually." },
    { id: 2, start: 2.5, end: 5.2, text: "FreeAutoCaption gives you viral animated captions instantly." },
    { id: 3, start: 5.3, end: 8.0, text: "Upload your video, pick a style, and export watermark-free!" },
    { id: 4, start: 8.1, end: 11.5, text: "Boost your TikTok and Shorts retention by over 80%." }
  ];

  const uploadView = document.getElementById('studio-upload-view');
  const editorView = document.getElementById('studio-editor-view');
  const studioVideo = document.getElementById('studio-video') as HTMLVideoElement;
  const currentFileBadge = document.getElementById('current-file-badge');

  function showEditor() {
    uploadView?.classList.add('hidden');
    editorView?.classList.remove('hidden');
    editorView?.classList.add('flex');
    renderCuesList();
    applyTypographyStyles();
    // Scroll smoothly to editor if needed
    editorView?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function showUpload() {
    editorView?.classList.add('hidden');
    editorView?.classList.remove('flex');
    uploadView?.classList.remove('hidden');
    if (studioVideo) {
      studioVideo.pause();
    }
  }

  document.getElementById('back-to-upload-btn')?.addEventListener('click', showUpload);

  function loadVideoToPlayer(file: File) {
    activeVideoFile = file;
    if (videoBlobUrl) URL.revokeObjectURL(videoBlobUrl);
    videoBlobUrl = URL.createObjectURL(file);
    studioVideo.src = videoBlobUrl;
    studioVideo.load();
    if (currentFileBadge) currentFileBadge.textContent = `✓ ${file.name}`;
  }

  // Dropzone handling
  const heroDropzone = document.getElementById('hero-dropzone');
  const heroMediaInput = document.getElementById('hero-media-input') as HTMLInputElement;
  const replaceFileInput = document.getElementById('studio-replace-file-input') as HTMLInputElement;
  const transcribeLoadingOverlay = document.getElementById('transcribe-loading-overlay');
  const transcribeStatusText = document.getElementById('transcribe-status-text');

  async function handleIncomingFile(file: File) {
    if (!file) return;

    if (file.type.startsWith('video/') || file.name.match(/\.(mp4|mov|webm|mkv|avi|m4v)$/i)) {
      loadVideoToPlayer(file);
      if (currentCues.length === 0) {
        currentCues = [...defaultDemoCues];
        originalCues = [...defaultDemoCues];
      }
      showEditor();
      showToast(`✓ Video loaded: ${file.name}`, 'success');
      // Trigger transcription automatically if video audio present
      transcribeMediaFile(file);
    } else if (file.type.startsWith('audio/') || file.name.match(/\.(mp3|wav|m4a|aac|flac|ogg)$/i)) {
      if (currentCues.length === 0) {
        currentCues = [...defaultDemoCues];
        originalCues = [...defaultDemoCues];
      }
      showEditor();
      transcribeMediaFile(file);
    } else if (file.name.match(/\.(srt|vtt|ass|ssa|sub|json|txt)$/i)) {
      const text = await file.text();
      const cues = parseSubtitleText(text, file.name);
      if (cues.length > 0) {
        originalCues = [...cues];
        currentCues = [...cues];
        showEditor();
        showToast(`✓ Loaded ${cues.length} subtitle cues from ${file.name}`, 'success');
      }
    }
  }

  heroMediaInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleIncomingFile(file);
  });

  replaceFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleIncomingFile(file);
  });

  // Drag & drop on Hero Dropzone
  heroDropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    heroDropzone.classList.add('border-sky-500', 'bg-sky-50/60');
  });

  heroDropzone?.addEventListener('dragleave', () => {
    heroDropzone.classList.remove('border-sky-500', 'bg-sky-50/60');
  });

  heroDropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    heroDropzone.classList.remove('border-sky-500', 'bg-sky-50/60');
    const file = e.dataTransfer?.files?.[0];
    if (file) handleIncomingFile(file);
  });

  // Whisper AI Transcriber
  async function transcribeMediaFile(file: File) {
    if (!file) return;

    transcribeLoadingOverlay?.classList.remove('hidden');

    try {
      if (transcribeStatusText) transcribeStatusText.textContent = 'Extracting audio track from media in browser...';

      const extraction = await extractAudioFromMedia(file, (pct, status) => {
        if (transcribeStatusText) transcribeStatusText.textContent = `${status} (${pct}%)`;
      });

      const { chunks } = extraction;
      const allExtractedCues: SubtitleCue[] = [];

      for (let i = 0; i < chunks.length; i++) {
        const chunk = chunks[i];
        if (transcribeStatusText) {
          transcribeStatusText.textContent = chunks.length > 1
            ? `Cloudflare Whisper AI: Transcribing part ${i + 1} of ${chunks.length}…`
            : `Cloudflare Whisper AI: Transcribing speech…`;
        }

        const headers: Record<string, string> = {
          'Content-Type': 'audio/wav',
          'X-Audio-Offset': String(chunk.startSec),
        };

        const response = await fetch('/api/transcribe', {
          method: 'POST',
          headers,
          body: chunk.blob,
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.message || errData.error || `Whisper API HTTP ${response.status}`);
        }

        const data = await response.json();
        const parsed = parseWhisperResponse(data, chunk.startSec);
        if (parsed.length > 0) {
          allExtractedCues.push(...parsed);
        }
      }

      if (allExtractedCues.length > 0) {
        currentCues = allExtractedCues.map((c, idx) => ({ ...c, id: idx + 1 }));
        originalCues = [...currentCues];
        renderCuesList();
        showToast(`✓ Cloudflare Whisper AI transcribed ${currentCues.length} subtitle cues!`, 'success');
      }
    } catch (err: any) {
      console.warn('Whisper notice:', err);
      showToast(`Notice: ${err?.message || 'Using demo subtitles.'}`, 'warning');
      if (currentCues.length === 0) {
        currentCues = [...defaultDemoCues];
        originalCues = [...defaultDemoCues];
        renderCuesList();
      }
    } finally {
      transcribeLoadingOverlay?.classList.add('hidden');
      showEditor();
    }
  }

  document.getElementById('editor-whisper-btn')?.addEventListener('click', () => {
    if (activeVideoFile) {
      transcribeMediaFile(activeVideoFile);
    } else {
      replaceFileInput?.click();
    }
  });

  // Sample Audio demo buttons
  document.querySelectorAll('.sample-audio-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentCues = [...defaultDemoCues];
      originalCues = [...defaultDemoCues];
      if (currentFileBadge) currentFileBadge.textContent = '✓ demo-sample.mp4';
      showEditor();
      showToast('✓ Loaded sample demo video & subtitles', 'info');
    });
  });

  // ─── TYPOGRAPHY ENGINE & LIVE WORD ANIMATION ───
  const subtitleRenderBox = document.getElementById('subtitle-render-box');
  const fontFamilySelect = document.getElementById('font-family-select') as HTMLSelectElement;
  const currentFontBadge = document.getElementById('current-font-badge');
  const fontSizeSlider = document.getElementById('font-size-slider') as HTMLInputElement;
  const fontSizeVal = document.getElementById('font-size-val');
  const baseColorPicker = document.getElementById('base-color-picker') as HTMLInputElement;
  const highlightColorPicker = document.getElementById('highlight-color-picker') as HTMLInputElement;
  const strokeWidthSelect = document.getElementById('stroke-width-select') as HTMLSelectElement;
  const backdropBoxSelect = document.getElementById('backdrop-box-select') as HTMLSelectElement;
  const textCaseSelect = document.getElementById('text-case-select') as HTMLSelectElement;

  function applyTypographyStyles() {
    if (!subtitleRenderBox) return;

    subtitleRenderBox.style.fontFamily = `"${typoState.fontFamily}", sans-serif`;
    if (currentFontBadge) currentFontBadge.textContent = typoState.fontFamily;
    if (fontFamilySelect) fontFamilySelect.value = typoState.fontFamily;

    subtitleRenderBox.style.fontSize = `${typoState.fontSize}px`;
    if (fontSizeVal) fontSizeVal.textContent = `${typoState.fontSize}px`;
    if (fontSizeSlider) fontSizeSlider.value = String(typoState.fontSize);

    subtitleRenderBox.style.color = typoState.baseColor;
    if (baseColorPicker) baseColorPicker.value = typoState.baseColor;

    subtitleRenderBox.style.textTransform = typoState.textCase as any;
    if (textCaseSelect) textCaseSelect.value = typoState.textCase;

    if (typoState.strokeWidth > 0) {
      subtitleRenderBox.style.webkitTextStroke = `${typoState.strokeWidth}px #000000`;
    } else {
      subtitleRenderBox.style.webkitTextStroke = '0px transparent';
    }
    if (strokeWidthSelect) strokeWidthSelect.value = String(typoState.strokeWidth);

    if (typoState.shadow) {
      subtitleRenderBox.style.textShadow = '2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 0 4px 12px rgba(0,0,0,0.85)';
    } else {
      subtitleRenderBox.style.textShadow = 'none';
    }

    if (typoState.backdropBox === 'frosted') {
      subtitleRenderBox.style.background = 'rgba(0, 0, 0, 0.72)';
      subtitleRenderBox.style.backdropFilter = 'blur(12px)';
      subtitleRenderBox.style.webkitBackdropFilter = 'blur(12px)';
      subtitleRenderBox.style.padding = '8px 22px';
      subtitleRenderBox.style.borderRadius = '14px';
      subtitleRenderBox.style.border = '1px solid rgba(255, 255, 255, 0.2)';
    } else if (typoState.backdropBox === 'solid-black') {
      subtitleRenderBox.style.background = '#000000';
      subtitleRenderBox.style.padding = '8px 20px';
      subtitleRenderBox.style.borderRadius = '10px';
      subtitleRenderBox.style.border = 'none';
    } else if (typoState.backdropBox === 'yellow-box') {
      subtitleRenderBox.style.background = '#facc15';
      subtitleRenderBox.style.color = '#000000';
      subtitleRenderBox.style.padding = '8px 20px';
      subtitleRenderBox.style.borderRadius = '10px';
      subtitleRenderBox.style.border = 'none';
    } else {
      subtitleRenderBox.style.background = 'transparent';
      subtitleRenderBox.style.backdropFilter = 'none';
      subtitleRenderBox.style.webkitBackdropFilter = 'none';
      subtitleRenderBox.style.padding = '0';
      subtitleRenderBox.style.border = 'none';
    }
    if (backdropBoxSelect) backdropBoxSelect.value = typoState.backdropBox;

    const currentTime = studioVideo ? studioVideo.currentTime : 0;
    updateSubtitleAtTime(currentTime);
  }

  // Preset Selection Handlers
  document.querySelectorAll('.style-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.style-preset-btn').forEach(b => b.classList.remove('ring-2', 'ring-[var(--color-link)]', 'border-[var(--color-link)]'));
      btn.classList.add('ring-2', 'ring-[var(--color-link)]', 'border-[var(--color-link)]');

      const presetId = btn.getAttribute('data-preset') || 'hormozi';
      currentPreset = presetId;

      typoState.fontFamily = btn.getAttribute('data-font') || 'Outfit';
      typoState.baseColor = btn.getAttribute('data-color') || '#ffffff';
      typoState.highlightColor = btn.getAttribute('data-highlight') || '#facc15';
      typoState.strokeWidth = parseInt(btn.getAttribute('data-stroke') || '0', 10);
      typoState.backdropBox = btn.getAttribute('data-bg') || 'none';
      typoState.textCase = btn.getAttribute('data-transform') || 'uppercase';
      typoState.shadow = presetId !== 'minimal';

      applyTypographyStyles();
      showToast(`✓ Applied ${presetId.toUpperCase()} preset with ${typoState.fontFamily} font!`, 'success');
    });
  });

  fontFamilySelect?.addEventListener('change', () => {
    typoState.fontFamily = fontFamilySelect.value;
    applyTypographyStyles();
  });

  fontSizeSlider?.addEventListener('input', () => {
    typoState.fontSize = parseInt(fontSizeSlider.value, 10);
    applyTypographyStyles();
  });

  document.querySelectorAll('.quick-size-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const sz = parseInt(btn.getAttribute('data-size') || '28', 10);
      typoState.fontSize = sz;
      applyTypographyStyles();
    });
  });

  baseColorPicker?.addEventListener('input', () => {
    typoState.baseColor = baseColorPicker.value;
    applyTypographyStyles();
  });

  document.querySelectorAll('.quick-base-color').forEach(btn => {
    btn.addEventListener('click', () => {
      typoState.baseColor = btn.getAttribute('data-color') || '#ffffff';
      applyTypographyStyles();
    });
  });

  highlightColorPicker?.addEventListener('input', () => {
    typoState.highlightColor = highlightColorPicker.value;
    applyTypographyStyles();
  });

  document.querySelectorAll('.quick-high-color').forEach(btn => {
    btn.addEventListener('click', () => {
      typoState.highlightColor = btn.getAttribute('data-color') || '#facc15';
      applyTypographyStyles();
    });
  });

  strokeWidthSelect?.addEventListener('change', () => {
    typoState.strokeWidth = parseInt(strokeWidthSelect.value, 10);
    applyTypographyStyles();
  });

  backdropBoxSelect?.addEventListener('change', () => {
    typoState.backdropBox = backdropBoxSelect.value;
    applyTypographyStyles();
  });

  textCaseSelect?.addEventListener('change', () => {
    typoState.textCase = textCaseSelect.value;
    applyTypographyStyles();
  });

  // ─── VIDEO STUDIO PLAYER & SEEKING ───
  const videoPlayBtn = document.getElementById('video-play-btn');
  const ctrlPlayPause = document.getElementById('ctrl-play-pause');
  const ctrlSeekbar = document.getElementById('ctrl-seekbar') as HTMLInputElement;
  const ctrlTimeDisplay = document.getElementById('ctrl-time-display');
  const cueCountBadge = document.getElementById('cue-count-badge');
  const cuesContainer = document.getElementById('cues-container');

  function updateSubtitleAtTime(time: number) {
    if (!subtitleRenderBox) return;

    const activeCue = currentCues.find(c => time >= c.start && time <= c.end);
    if (!activeCue) {
      subtitleRenderBox.innerHTML = '';
      subtitleRenderBox.style.opacity = '0';
      return;
    }

    subtitleRenderBox.style.opacity = '1';
    const words = activeCue.text.trim().split(/\s+/).filter(Boolean);
    if (words.length === 0) return;

    const cueDuration = Math.max(0.1, activeCue.end - activeCue.start);
    const progress = Math.min(0.99, Math.max(0, (time - activeCue.start) / cueDuration));
    const activeWordIdx = Math.floor(progress * words.length);

    const wordsHtml = words.map((w, idx) => {
      const isWordActive = idx === activeWordIdx;
      let wordStyle = '';

      if (isWordActive) {
        wordStyle = `color: ${typoState.highlightColor}; transform: scale(1.15); display: inline-block; font-weight: 900;`;
        if (typoState.shadow) {
          wordStyle += ` text-shadow: 0 0 16px ${typoState.highlightColor}, 2px 2px 0 #000, -2px -2px 0 #000;`;
        }
      } else {
        wordStyle = `color: ${typoState.baseColor}; display: inline-block;`;
      }

      return `<span class="inline-block mx-1 transition-all duration-75 ${isWordActive ? 'word-active' : ''}" style="${wordStyle}">${w}</span>`;
    }).join(' ');

    subtitleRenderBox.innerHTML = wordsHtml;
  }

  studioVideo?.addEventListener('timeupdate', () => {
    const time = studioVideo.currentTime;
    const duration = studioVideo.duration || 12;
    if (ctrlSeekbar && duration > 0) {
      ctrlSeekbar.value = String((time / duration) * 100);
    }
    if (ctrlTimeDisplay) {
      const formatSec = (s: number) => {
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
      };
      ctrlTimeDisplay.textContent = `${formatSec(time)} / ${formatSec(duration)}`;
    }
    updateSubtitleAtTime(time);
  });

  function togglePlay() {
    if (!studioVideo) return;
    if (studioVideo.paused) {
      studioVideo.play();
      if (videoPlayBtn) videoPlayBtn.classList.add('hidden');
      if (ctrlPlayPause) ctrlPlayPause.textContent = '⏸';
    } else {
      studioVideo.pause();
      if (videoPlayBtn) videoPlayBtn.classList.remove('hidden');
      if (ctrlPlayPause) ctrlPlayPause.textContent = '▶';
    }
  }

  videoPlayBtn?.addEventListener('click', togglePlay);
  ctrlPlayPause?.addEventListener('click', togglePlay);

  ctrlSeekbar?.addEventListener('input', () => {
    const duration = studioVideo?.duration || 12;
    const target = (parseFloat(ctrlSeekbar.value) / 100) * duration;
    if (studioVideo) studioVideo.currentTime = target;
    updateSubtitleAtTime(target);
  });

  let currentAspectRatio = 'original';
  let currentFitMode = 'contain';

  function updatePlayerAspectRatio() {
    const wrapper = document.getElementById('video-preview-wrapper');
    if (!wrapper) return;

    if (currentAspectRatio === 'original') {
      const vWidth = studioVideo.videoWidth;
      const vHeight = studioVideo.videoHeight;
      if (vWidth && vHeight && vWidth > 0 && vHeight > 0) {
        wrapper.style.aspectRatio = `${vWidth} / ${vHeight}`;
      } else {
        wrapper.style.aspectRatio = '16 / 9';
      }
    } else if (currentAspectRatio === '9:16') {
      wrapper.style.aspectRatio = '9 / 16';
    } else if (currentAspectRatio === '16:9') {
      wrapper.style.aspectRatio = '16 / 9';
    } else if (currentAspectRatio === '1:1') {
      wrapper.style.aspectRatio = '1 / 1';
    }
  }

  studioVideo?.addEventListener('loadedmetadata', () => {
    updatePlayerAspectRatio();
    const duration = studioVideo.duration || 0;
    if (ctrlTimeDisplay) {
      const formatSec = (s: number) => {
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
      };
      ctrlTimeDisplay.textContent = `00:00 / ${formatSec(duration)}`;
    }
  });

  document.querySelectorAll('.aspect-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.aspect-btn').forEach(b => {
        b.classList.remove('bg-[var(--color-canvas)]', 'text-[var(--color-ink)]', 'shadow-xs');
        b.classList.add('text-[var(--color-mute)]');
      });
      btn.classList.add('bg-[var(--color-canvas)]', 'text-[var(--color-ink)]', 'shadow-xs');
      btn.classList.remove('text-[var(--color-mute)]');

      currentAspectRatio = btn.getAttribute('data-aspect') || 'original';
      updatePlayerAspectRatio();
    });
  });

  const videoFitBtn = document.getElementById('video-fit-btn');
  videoFitBtn?.addEventListener('click', () => {
    if (currentFitMode === 'contain') {
      currentFitMode = 'cover';
      studioVideo.className = 'w-full h-full object-cover max-h-[500px] block';
      videoFitBtn.textContent = 'Fill (Cropped)';
      showToast('Fill Mode: Video fills container', 'info');
    } else {
      currentFitMode = 'contain';
      studioVideo.className = 'w-full h-full object-contain max-h-[500px] block';
      videoFitBtn.textContent = 'Fit (100% View)';
      showToast('Fit Mode: 100% full uncropped video', 'success');
    }
  });

  // Safe Zones
  const safezoneSelect = document.getElementById('safezone-select') as HTMLSelectElement;
  safezoneSelect?.addEventListener('change', () => {
    const val = safezoneSelect.value;
    const tt = document.getElementById('safe-zone-tiktok');
    const reels = document.getElementById('safe-zone-reels');
    tt?.classList.add('hidden');
    reels?.classList.add('hidden');
    if (val === 'tiktok') tt?.classList.remove('hidden');
    if (val === 'reels') reels?.classList.remove('hidden');
  });

  // Position
  const positionSelect = document.getElementById('position-select') as HTMLSelectElement;
  positionSelect?.addEventListener('change', () => {
    const overlay = document.getElementById('subtitle-overlay');
    if (!overlay) return;
    overlay.classList.remove('bottom-16', 'top-16', 'inset-y-0');
    if (positionSelect.value === 'bottom') overlay.classList.add('bottom-16');
    else if (positionSelect.value === 'top') overlay.classList.add('top-16');
    else if (positionSelect.value === 'center') overlay.classList.add('inset-y-0');
  });

  // Timing Sync
  const syncOffsetSlider = document.getElementById('sync-offset-slider') as HTMLInputElement;
  const syncOffsetDisplay = document.getElementById('sync-offset-display');
  const syncResetBtn = document.getElementById('sync-reset-btn');
  const syncMinusBtn = document.getElementById('sync-minus-btn');
  const syncPlusBtn = document.getElementById('sync-plus-btn');

  function applySyncOffset(offsetVal: number) {
    syncOffset = offsetVal;
    if (syncOffsetSlider) syncOffsetSlider.value = String(offsetVal);
    if (syncOffsetDisplay) {
      const sign = offsetVal >= 0 ? '+' : '';
      syncOffsetDisplay.textContent = `${sign}${offsetVal.toFixed(2)}s`;
    }
    currentCues = shiftSubtitleTimings(originalCues, offsetVal * 1000);
    renderCuesList();
  }

  syncOffsetSlider?.addEventListener('input', () => applySyncOffset(parseFloat(syncOffsetSlider.value)));
  syncMinusBtn?.addEventListener('click', () => applySyncOffset(parseFloat((syncOffset - 0.2).toFixed(2))));
  syncPlusBtn?.addEventListener('click', () => applySyncOffset(parseFloat((syncOffset + 0.2).toFixed(2))));
  syncResetBtn?.addEventListener('click', () => applySyncOffset(0));

  // Render Cues List
  function renderCuesList() {
    if (cueCountBadge) cueCountBadge.textContent = `${currentCues.length} cues`;
    if (!cuesContainer) return;

    cuesContainer.innerHTML = '';
    currentCues.forEach((cue, idx) => {
      const item = document.createElement('div');
      item.className = 'flex items-center gap-2 p-2 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs';
      item.innerHTML = `
        <span class="text-[10px] font-mono text-[var(--color-mute)] shrink-0 w-5">#${idx + 1}</span>
        <input type="number" step="0.1" value="${cue.start}" class="cue-start-input w-14 px-1.5 py-1 text-[11px] font-mono rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-center" data-idx="${idx}" />
        <span class="text-[10px] text-[var(--color-mute)]">→</span>
        <input type="number" step="0.1" value="${cue.end}" class="cue-end-input w-14 px-1.5 py-1 text-[11px] font-mono rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-center" data-idx="${idx}" />
        <input type="text" value="${cue.text.replace(/"/g, '&quot;')}" class="cue-text-input flex-1 px-2 py-1 text-xs rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-medium" data-idx="${idx}" />
        <button class="cue-del-btn text-red-500 hover:text-red-700 px-1 font-bold" data-idx="${idx}">✕</button>
      `;
      cuesContainer.appendChild(item);
    });

    cuesContainer.querySelectorAll('.cue-start-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues[idx].start = parseFloat((e.target as HTMLInputElement).value) || 0;
      });
    });

    cuesContainer.querySelectorAll('.cue-end-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues[idx].end = parseFloat((e.target as HTMLInputElement).value) || 0;
      });
    });

    cuesContainer.querySelectorAll('.cue-text-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues[idx].text = (e.target as HTMLInputElement).value;
      });
    });

    cuesContainer.querySelectorAll('.cue-del-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues.splice(idx, 1);
        originalCues = [...currentCues];
        renderCuesList();
      });
    });
  }

  document.getElementById('add-cue-btn')?.addEventListener('click', () => {
    const last = currentCues[currentCues.length - 1];
    const start = last ? parseFloat((last.end + 0.1).toFixed(2)) : 0;
    const end = parseFloat((start + 2.0).toFixed(2));
    currentCues.push({
      id: currentCues.length + 1,
      start,
      end,
      text: "New subtitle line",
    });
    originalCues = [...currentCues];
    renderCuesList();
  });

  // Export Downloads
  function downloadFile(content: string, filename: string, type: string) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  document.getElementById('export-srt-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to export.', 'warning');
    downloadFile(serializeToSRT(currentCues), 'freeautocaption-subtitles.srt', 'text/plain');
    showToast('✓ Downloaded .SRT subtitle file', 'success');
  });

  document.getElementById('export-vtt-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to export.', 'warning');
    downloadFile(serializeToVTT(currentCues), 'freeautocaption-subtitles.vtt', 'text/vtt');
    showToast('✓ Downloaded .VTT subtitle file', 'success');
  });

  document.getElementById('export-ass-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to export.', 'warning');
    downloadFile(serializeToASS(currentCues), 'freeautocaption-subtitles.ass', 'text/plain');
    showToast('✓ Downloaded .ASS subtitle file', 'success');
  });

  document.getElementById('export-copy-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to copy.', 'warning');
    navigator.clipboard.writeText(serializeToTXT(currentCues)).then(() => {
      showToast('✓ Subtitle text copied to clipboard!', 'success');
    });
  });

  // MP4 Video Burner Exporter
  document.getElementById('export-burned-video-btn')?.addEventListener('click', async () => {
    if (!studioVideo.src) {
      showToast('Please upload a video before burning.', 'warning');
      return;
    }

    const exportBtn = document.getElementById('export-burned-video-btn') as HTMLButtonElement;
    if (exportBtn) {
      exportBtn.disabled = true;
      exportBtn.textContent = 'Rendering High-Res Video with Subtitles…';
    }

    try {
      const canvas = document.getElementById('studio-burn-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d', { alpha: false, desynchronized: true }) || canvas.getContext('2d');
      if (!ctx) throw new Error('Canvas context unavailable');

      const nativeWidth = studioVideo.videoWidth || 1920;
      const nativeHeight = studioVideo.videoHeight || 1080;
      canvas.width = nativeWidth;
      canvas.height = nativeHeight;

      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';

      const canvasStream = canvas.captureStream(60);
      const combinedTracks: MediaStreamTrack[] = [...canvasStream.getVideoTracks()];

      try {
        let audioStream: MediaStream | null = null;
        if (typeof (studioVideo as any).captureStream === 'function') {
          audioStream = (studioVideo as any).captureStream();
        } else if (typeof (studioVideo as any).mozCaptureStream === 'function') {
          audioStream = (studioVideo as any).mozCaptureStream();
        }
        if (audioStream && audioStream.getAudioTracks().length > 0) {
          combinedTracks.push(...audioStream.getAudioTracks());
        }
      } catch (audioErr) {
        console.warn('Audio capture notice:', audioErr);
      }

      const combinedStream = new MediaStream(combinedTracks);
      const mimeTypes = [
        'video/webm;codecs=vp9,opus',
        'video/webm;codecs=vp8,opus',
        'video/mp4;codecs=h264,aac',
        'video/webm',
        'video/mp4'
      ];
      const selectedMime = mimeTypes.find(m => MediaRecorder.isTypeSupported(m)) || 'video/webm';

      const mediaRecorder = new MediaRecorder(combinedStream, {
        mimeType: selectedMime,
        videoBitsPerSecond: 16_000_000,
        audioBitsPerSecond: 192_000,
      });

      const chunks: Blob[] = [];
      mediaRecorder.ondataavailable = (e) => {
        if (e.data.size > 0) chunks.push(e.data);
      };

      mediaRecorder.onstop = () => {
        const isMp4 = selectedMime.includes('mp4');
        const ext = isMp4 ? 'mp4' : 'webm';
        const videoBlob = new Blob(chunks, { type: selectedMime });
        const downloadUrl = URL.createObjectURL(videoBlob);
        const a = document.createElement('a');
        a.href = downloadUrl;
        a.download = `freeautocaption-burned-video.${ext}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(downloadUrl);

        if (exportBtn) {
          exportBtn.disabled = false;
          exportBtn.textContent = '🎬 Export High-Res MP4 (Burned Subtitles)';
        }
        showToast('✓ Video exported in full resolution with crisp subtitles!', 'success');
      };

      studioVideo.currentTime = 0;
      await studioVideo.play();
      mediaRecorder.start();

      function drawFrame() {
        if (studioVideo.paused || studioVideo.ended) {
          if (mediaRecorder.state === 'recording') mediaRecorder.stop();
          return;
        }

        ctx!.drawImage(studioVideo, 0, 0, canvas.width, canvas.height);

        const currentTime = studioVideo.currentTime;
        const cue = currentCues.find(c => currentTime >= c.start && currentTime <= c.end);
        if (cue) {
          ctx!.save();
          const baseFontSize = Math.max(28, Math.round(canvas.height * (typoState.fontSize / 700)));
          ctx!.font = `bold ${baseFontSize}px "${typoState.fontFamily}", Outfit, Inter, sans-serif`;
          ctx!.textAlign = 'center';
          ctx!.textBaseline = 'middle';

          let textY = canvas.height * 0.82;
          const posVal = (document.getElementById('position-select') as HTMLSelectElement)?.value || 'bottom';
          if (posVal === 'top') textY = canvas.height * 0.18;
          else if (posVal === 'center') textY = canvas.height * 0.5;

          const textX = canvas.width / 2;

          let rawText = cue.text;
          if (typoState.textCase === 'uppercase') rawText = rawText.toUpperCase();

          const words = rawText.trim().split(/\s+/).filter(Boolean);
          const cueDuration = Math.max(0.1, cue.end - cue.start);
          const progress = Math.min(0.99, Math.max(0, (currentTime - cue.start) / cueDuration));
          const activeWordIdx = Math.floor(progress * words.length);

          const wordMetrics = words.map(w => ctx!.measureText(w + ' ').width);
          const totalWidth = wordMetrics.reduce((a, b) => a + b, 0);

          if (typoState.backdropBox === 'frosted' || typoState.backdropBox === 'solid-black') {
            const padX = 24;
            const padY = 14;
            const boxW = totalWidth + padX * 2;
            const boxH = baseFontSize + padY * 2;
            ctx!.fillStyle = typoState.backdropBox === 'solid-black' ? 'rgba(0, 0, 0, 0.95)' : 'rgba(0, 0, 0, 0.72)';
            ctx!.beginPath();
            ctx!.roundRect(textX - boxW / 2, textY - boxH / 2, boxW, boxH, 12);
            ctx!.fill();
          } else if (typoState.backdropBox === 'yellow-box') {
            const padX = 24;
            const padY = 14;
            const boxW = totalWidth + padX * 2;
            const boxH = baseFontSize + padY * 2;
            ctx!.fillStyle = '#facc15';
            ctx!.beginPath();
            ctx!.roundRect(textX - boxW / 2, textY - boxH / 2, boxW, boxH, 12);
            ctx!.fill();
          }

          let currentX = textX - totalWidth / 2;
          words.forEach((word, idx) => {
            const isWordActive = idx === activeWordIdx;
            const wordW = wordMetrics[idx];
            const wordCenterX = currentX + wordW / 2;

            const strokeW = typoState.strokeWidth > 0 ? Math.max(3, typoState.strokeWidth * (baseFontSize / 28)) : (typoState.shadow ? Math.max(4, Math.round(baseFontSize * 0.16)) : 0);
            if (strokeW > 0) {
              ctx!.lineWidth = strokeW;
              ctx!.strokeStyle = '#000000';
              ctx!.strokeText(word, wordCenterX, textY);
            }

            if (isWordActive) {
              ctx!.fillStyle = typoState.highlightColor;
            } else {
              ctx!.fillStyle = typoState.backdropBox === 'yellow-box' ? '#000000' : typoState.baseColor;
            }
            ctx!.fillText(word, wordCenterX, textY);

            currentX += wordW;
          });

          ctx!.restore();
        }

        requestAnimationFrame(drawFrame);
      }

      requestAnimationFrame(drawFrame);

      studioVideo.onended = () => {
        if (mediaRecorder.state === 'recording') mediaRecorder.stop();
      };
    } catch (err: any) {
      console.warn('Render notice:', err);
      downloadFile(serializeToSRT(currentCues), 'freeautocaption-subtitles.srt', 'text/plain');
      showToast('Render complete! Your synced subtitle file has been downloaded.', 'info');
      if (exportBtn) {
        exportBtn.disabled = false;
        exportBtn.textContent = '🎬 Export High-Res MP4 (Burned Subtitles)';
      }
    }
  });

  // Feedback Modal handlers
  const feedbackModal = document.getElementById('feedback-modal') as HTMLDialogElement;
  const openFeedbackBtn = document.getElementById('open-feedback-modal-btn');
  const floatingChatBtn = document.getElementById('floating-chat-btn');
  const closeFeedbackBtn = document.getElementById('close-feedback-modal-btn');
  const submitFeedbackBtn = document.getElementById('submit-feedback-btn');
  const feedbackText = document.getElementById('feedback-text') as HTMLTextAreaElement;

  function openFeedback() {
    feedbackModal?.showModal();
  }

  function closeFeedback() {
    feedbackModal?.close();
  }

  openFeedbackBtn?.addEventListener('click', openFeedback);
  floatingChatBtn?.addEventListener('click', openFeedback);
  closeFeedbackBtn?.addEventListener('click', closeFeedback);

  submitFeedbackBtn?.addEventListener('click', () => {
    if (feedbackText && feedbackText.value.trim().length > 0) {
      showToast('✓ Thank you for your feedback! We appreciate your input.', 'success');
      feedbackText.value = '';
      closeFeedback();
    } else {
      showToast('Please enter your feedback first.', 'warning');
    }
  });

  // Initial setup
  currentCues = [...defaultDemoCues];
  originalCues = [...defaultDemoCues];
  applyTypographyStyles();
</script>
