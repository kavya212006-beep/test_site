---
import { t } from '../../i18n/utils';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const stylePresets = [
  { id: 'hormozi', nameKey: 'styles.hormozi', icon: '🔥', font: 'Outfit', color: '#ffffff', highlight: '#facc15', stroke: 0, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Bold yellow pop, high-energy viral retention' },
  { id: 'beast', nameKey: 'styles.beast', icon: '⚡', font: 'Syne', color: '#ffffff', highlight: '#38bdf8', stroke: 2, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Thick black stroke with cyan bounce' },
  { id: 'cinematic', nameKey: 'styles.cinematic', icon: '🎬', font: 'Inter', color: '#ffffff', highlight: '#60a5fa', stroke: 0, shadow: false, bg: 'frosted', transform: 'none', desc: 'Frosted dark pill box for film & docs' },
  { id: 'neon', nameKey: 'styles.neon', icon: '💜', font: 'Space Grotesk', color: '#ffffff', highlight: '#ff0080', stroke: 0, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Cyberpunk glowing cyan & pink neon' },
  { id: 'bangers', nameKey: 'styles.bangers', icon: '💥', font: 'Bangers', color: '#facc15', highlight: '#ff0055', stroke: 2, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Comic action pop with heavy stroke' },
  { id: 'marker', nameKey: 'styles.marker', icon: '✍️', font: 'Permanent Marker', color: '#ffffff', highlight: '#a855f7', stroke: 0, shadow: true, bg: 'none', transform: 'none', desc: 'Urban handwritten graffiti style' },
  { id: 'bebas', nameKey: 'styles.bebas', icon: '🚀', font: 'Bebas Neue', color: '#ffffff', highlight: '#fb923c', stroke: 0, shadow: true, bg: 'none', transform: 'uppercase', desc: 'Tall condensed viral headline punch' },
  { id: 'karaoke', nameKey: 'styles.karaoke', icon: '🎤', font: 'Outfit', color: 'rgba(255,255,255,0.7)', highlight: '#4ade80', stroke: 0, shadow: true, bg: 'none', transform: 'none', desc: 'Smooth progressive green highlight' },
  { id: 'minimal', nameKey: 'styles.minimal', icon: '✨', font: 'Inter', color: '#ffffff', highlight: '#ffffff', stroke: 0, shadow: false, bg: 'none', transform: 'none', desc: 'Clean modern typography' },
];

const fontFamilies = [
  { name: 'Outfit (Viral Standard)', value: 'Outfit', category: 'Modern Geometric Sans' },
  { name: 'Anton (Ultra Bold Impact)', value: 'Anton', category: 'Headline Bold' },
  { name: 'Montserrat (Heavy Black 900)', value: 'Montserrat', category: 'Bold Punch' },
  { name: 'Bebas Neue (Tall Condensed)', value: 'Bebas Neue', category: 'Cinematic Hook' },
  { name: 'Syne (High-Energy Punch)', value: 'Syne', category: 'Trendy Viral' },
  { name: 'Bangers (Comic Action / Beast)', value: 'Bangers', category: 'Comic Cartoon' },
  { name: 'Luckiest Guy (Playful Bold)', value: 'Luckiest Guy', category: 'Playful Punch' },
  { name: 'Permanent Marker (Graffiti / Urban)', value: 'Permanent Marker', category: 'Handwritten' },
  { name: 'Space Grotesk (Cyberpunk Neon)', value: 'Space Grotesk', category: 'Futuristic' },
  { name: 'Cinzel (Epic Cinematic)', value: 'Cinzel', category: 'Luxury Film' },
  { name: 'Playfair Display (Editorial Serif)', value: 'Playfair Display', category: 'Classic Luxury' },
  { name: 'JetBrains Mono (Tech & Code)', value: 'JetBrains Mono', category: 'Monospace' },
  { name: 'Inter (Clean Minimalist)', value: 'Inter', category: 'Neutral Sans' },
];
---

<div id="subtitle-studio" class="w-full flex flex-col gap-8">

  <!-- Notification Toast Container -->
  <div id="studio-toast" class="hidden fixed top-6 right-6 z-50 max-w-md p-4 rounded-xl shadow-l3 border transition-all flex items-center gap-3">
    <span id="studio-toast-icon" class="text-xl"></span>
    <p id="studio-toast-msg" class="text-sm font-medium"></p>
  </div>

  <!-- ─── Studio Main Card ─────────────────────────────────── -->
  <div class="bg-[var(--color-canvas)] rounded-2xl border border-[var(--color-hairline)] shadow-l3 overflow-hidden">

    <!-- Top Workflow Tabs Bar -->
    <div class="flex items-center border-b border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] px-4 pt-3 overflow-x-auto scrollbar-hide gap-1" role="tablist">
      <button
        id="tab-btn-burn"
        role="tab"
        aria-selected="true"
        aria-controls="panel-burn"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-semibold border-b-2 border-[var(--color-ink)] text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>🔥</span>
        <span>{t(lang, 'studio.tab.burn')}</span>
        <span class="px-1.5 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded bg-[var(--color-ink)] text-[var(--color-canvas)]">Top</span>
      </button>

      <button
        id="tab-btn-audio"
        role="tab"
        aria-selected="false"
        aria-controls="panel-audio"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>🎙️</span>
        <span>{t(lang, 'studio.tab.audio')}</span>
        <span class="px-1.5 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded bg-[var(--color-grad-blue-start)]/10 text-[var(--color-grad-blue-start)]">Cloudflare AI</span>
      </button>

      <button
        id="tab-btn-script"
        role="tab"
        aria-selected="false"
        aria-controls="panel-script"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>📝</span>
        <span>{t(lang, 'studio.tab.script')}</span>
      </button>

      <button
        id="tab-btn-editor"
        role="tab"
        aria-selected="false"
        aria-controls="panel-editor"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>🎬</span>
        <span>{t(lang, 'studio.tab.editor')}</span>
        <span class="ms-1 px-1.5 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded-md bg-[var(--color-link-bg-soft)] text-[var(--color-link)]">Live</span>
      </button>
    </div>

    <!-- ─── TAB 1: Video + Subtitle Burner (Upload Video & Subtitles) ─── -->
    <div id="panel-burn" role="tabpanel" class="p-6 md:p-8 flex flex-col gap-6">
      <div class="flex flex-col gap-1">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-[var(--color-link-bg-soft)] text-[var(--color-link)] uppercase tracking-wider">Fastest Workflow</span>
          <h3 class="display-sm text-[var(--color-ink)]">Upload Video & Subtitle File</h3>
        </div>
        <p class="text-sm text-[var(--color-body)]">Have a video file? Upload your video and subtitle file to sync, style, and burn them into high-res MP4 with zero watermark.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- 1. Video Dropzone -->
        <div class="flex flex-col gap-2">
          <label class="text-xs font-semibold text-[var(--color-ink)] uppercase tracking-wider">{t(lang, 'burn.upload.videoTitle')}</label>
          <label
            id="burn-video-dropzone"
            for="burn-video-input"
            class="flex flex-col items-center justify-center gap-3 w-full min-h-[190px] p-6 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-link)] hover:bg-[var(--color-link-bg-soft)]/40 rounded-2xl cursor-pointer transition-all group bg-[var(--color-canvas-soft)] relative text-center"
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
              🎥
            </div>
            <div>
              <p id="burn-video-name" class="text-sm font-semibold text-[var(--color-ink)]">Click to choose video or drop here</p>
              <p class="text-xs text-[var(--color-mute)] mt-0.5">{t(lang, 'burn.upload.videoSubtitle')}</p>
            </div>
            <input id="burn-video-input" type="file" accept="video/mp4,video/quicktime,video/webm,video/mkv,video/*" class="sr-only" />
          </label>
        </div>

        <!-- 2. Subtitle File Dropzone -->
        <div class="flex flex-col gap-2">
          <label class="text-xs font-semibold text-[var(--color-ink)] uppercase tracking-wider">{t(lang, 'burn.upload.subTitle')}</label>
          <label
            id="burn-sub-dropzone"
            for="burn-sub-input"
            class="flex flex-col items-center justify-center gap-3 w-full min-h-[190px] p-6 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-violet)] hover:bg-[var(--color-violet-soft)]/30 rounded-2xl cursor-pointer transition-all group bg-[var(--color-canvas-soft)] relative text-center"
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
              📄
            </div>
            <div>
              <p id="burn-sub-name" class="text-sm font-semibold text-[var(--color-ink)]">Click to upload .SRT, .VTT, .ASS</p>
              <p class="text-xs text-[var(--color-mute)] mt-0.5">{t(lang, 'burn.upload.subSubtitle')}</p>
            </div>
            <input id="burn-sub-input" type="file" accept=".srt,.vtt,.ass,.ssa,.sub,.json,.txt" class="sr-only" />
          </label>
        </div>
      </div>

      <!-- Quick Action / Auto-Transcribe Option -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
        <div class="flex items-center gap-3">
          <span class="text-xl">⚡</span>
          <p class="text-xs text-[var(--color-body)]">Don't have subtitles yet? <strong>Cloudflare Whisper AI</strong> can automatically extract and generate timestamped subtitles from your video audio.</p>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <button id="burn-auto-whisper-btn" type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-pill bg-[var(--color-link)] text-white text-sm font-semibold hover:opacity-90 transition-all shadow-l1 whitespace-nowrap">
            ⚡ Auto-Transcribe with Whisper
          </button>
          <button id="burn-start-btn" type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] text-sm font-semibold hover:opacity-90 transition-all shadow-l1 whitespace-nowrap">
            Open in Studio Editor →
          </button>
        </div>
      </div>
    </div>

    <!-- ─── TAB 2: AI Audio / Video Transcriber (Whisper Edge GPU) ─── -->
    <div id="panel-audio" role="tabpanel" class="hidden p-6 md:p-8 flex-col gap-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-[var(--color-grad-blue-start)]/10 text-[var(--color-grad-blue-start)] uppercase tracking-wider">Cloudflare Whisper AI</span>
            <h3 class="display-sm text-[var(--color-ink)]">{t(lang, 'studio.tab.audio')}</h3>
          </div>
          <p class="text-sm text-[var(--color-body)]">{t(lang, 'audio.drop.formats')}</p>
        </div>

        <!-- Spoken Language Selector -->
        <div class="flex items-center gap-2 shrink-0">
          <label for="whisper-lang-select" class="text-xs font-semibold text-[var(--color-mute)] uppercase tracking-wider">Language:</label>
          <select
            id="whisper-lang-select"
            class="px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-link)] transition-all cursor-pointer"
          >
            <option value="auto">🌐 Auto-Detect Language</option>
            <option value="en">🇺🇸 English</option>
            <option value="es">🇪🇸 Spanish (Español)</option>
            <option value="fr">🇫🇷 French (Français)</option>
            <option value="de">🇩🇪 German (Deutsch)</option>
            <option value="pt">🇧🇷 Portuguese (Português)</option>
            <option value="ja">🇯🇵 Japanese (日本語)</option>
            <option value="zh">🇨🇳 Chinese (中文)</option>
            <option value="ar">🇸🇦 Arabic (العربية)</option>
            <option value="it">🇮🇹 Italian (Italiano)</option>
            <option value="hi">🇮🇳 Hindi (हिन्दी)</option>
          </select>
        </div>
      </div>

      <!-- Drag & Drop Upload Zone -->
      <label
        id="audio-dropzone"
        for="media-file-input"
        class="flex flex-col items-center justify-center gap-4 w-full min-h-[220px] p-6 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-link)] hover:bg-[var(--color-link-bg-soft)] rounded-2xl cursor-pointer transition-all group relative bg-[var(--color-canvas-soft)] text-center"
      >
        <div class="w-16 h-16 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
          🎙️
        </div>
        <div>
          <p class="text-base font-semibold text-[var(--color-ink)]">{t(lang, 'audio.drop.title')}</p>
          <p class="text-xs text-[var(--color-mute)] mt-1">{t(lang, 'audio.drop.subtitle')}</p>
        </div>

        <input
          id="media-file-input"
          type="file"
          accept="audio/*,video/*,.mp4,.mov,.webm,.mkv,.mp3,.wav,.m4a"
          class="sr-only"
        />

        <!-- Loading Overlay -->
        <div id="transcribe-loading" class="hidden absolute inset-0 bg-[var(--color-canvas)]/95 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center gap-4 z-20">
          <div class="flex items-center gap-1.5 h-8">
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-1 h-6 animate-pulse"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-2 h-8 animate-pulse"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-3 h-4 animate-pulse"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-4 h-7 animate-pulse"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-5 h-5 animate-pulse"></div>
          </div>
          <p id="transcribe-status-text" class="text-sm font-semibold text-[var(--color-ink)] animate-pulse">{t(lang, 'audio.analyzing')}</p>
        </div>
      </label>

      <!-- Live Voice AI Recording & Demo Samples -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-medium text-[var(--color-mute)] uppercase tracking-wider">{t(lang, 'audio.sample.heading')}</span>
          <button class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all" data-sample="podcast">
            {t(lang, 'audio.sample.podcast')}
          </button>
          <button class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all" data-sample="motivation">
            {t(lang, 'audio.sample.motivation')}
          </button>
          <button class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all" data-sample="tutorial">
            {t(lang, 'audio.sample.tutorial')}
          </button>
        </div>

        <button
          id="live-speech-btn"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-all shadow-l1 shrink-0"
        >
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <span>Record Live Mic</span>
        </button>
      </div>
    </div>

    <!-- ─── TAB 3: Script to Subtitles ───────────────────────── -->
    <div id="panel-script" role="tabpanel" class="hidden p-6 md:p-8 flex-col gap-6">
      <div class="flex flex-col gap-1">
        <h3 class="display-sm text-[var(--color-ink)]">{t(lang, 'script.title')}</h3>
        <p class="text-sm text-[var(--color-body)]">{t(lang, 'script.subtitle')}</p>
      </div>

      <div class="relative">
        <textarea
          id="script-input"
          rows="6"
          placeholder={t(lang, 'script.placeholder')}
          class="w-full p-4 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-[var(--color-ink)] text-sm font-mono focus:outline-none focus:border-[var(--color-link)] focus:ring-2 focus:ring-[var(--color-link-bg-soft)] transition-all resize-y"
        ></textarea>
        <button
          id="insert-sample-script"
          type="button"
          class="absolute top-3 right-3 px-3 py-1.5 text-xs font-medium rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] shadow-xs transition-all"
        >
          {t(lang, 'script.sampleBtn')}
        </button>
      </div>

      <!-- Pacing & Segmentation Controls -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-medium text-[var(--color-body)]">{t(lang, 'script.wpm')}</span>
            <span id="wpm-display" class="font-bold text-[var(--color-ink)]">145 WPM</span>
          </div>
          <input
            id="wpm-slider"
            type="range"
            min="90"
            max="220"
            value="145"
            class="w-full accent-[var(--color-link)] cursor-pointer"
          />
        </div>

        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-medium text-[var(--color-body)]">{t(lang, 'script.wordsPerLine')}</span>
            <span id="wpl-display" class="font-bold text-[var(--color-ink)]">4 words (Viral)</span>
          </div>
          <input
            id="wpl-slider"
            type="range"
            min="1"
            max="10"
            value="4"
            class="w-full accent-[var(--color-link)] cursor-pointer"
          />
        </div>
      </div>

      <button
        id="generate-from-script-btn"
        type="button"
        class="self-start px-6 py-3 rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] text-sm font-semibold hover:opacity-90 transition-all shadow-l1"
      >
        {t(lang, 'script.generateBtn')} →
      </button>
    </div>

    <!-- ─── TAB 4: Live Video Studio & Editor (Canvas / Burner) ─── -->
    <div id="panel-editor" role="tabpanel" class="hidden p-6 md:p-8 flex-col gap-8">
      
      <!-- Studio Grid: Video Player + Controls -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Left Column: Video Preview Player & Canvas -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <h4 class="text-sm font-semibold text-[var(--color-ink)]">{t(lang, 'editor.heading')}</h4>
              <button id="editor-rewhisper-btn" type="button" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-[var(--color-link-bg-soft)] text-[var(--color-link)] hover:bg-[var(--color-link)] hover:text-white transition-all">
                ⚡ Auto-Transcribe with Whisper
              </button>
            </div>
            
            <div class="flex flex-wrap items-center gap-1.5">
              <!-- Aspect Ratio Selector -->
              <div class="flex items-center gap-1 p-1 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs">
                <button class="aspect-btn px-2.5 py-1 rounded font-medium text-[var(--color-ink)] bg-[var(--color-canvas)] shadow-xs transition-all" data-aspect="original" title="Display video in original uncropped aspect ratio">
                  🎯 Auto / Original
                </button>
                <button class="aspect-btn px-2.5 py-1 rounded font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="9:16">
                  9:16
                </button>
                <button class="aspect-btn px-2.5 py-1 rounded font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="16:9">
                  16:9
                </button>
                <button class="aspect-btn px-2.5 py-1 rounded font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="1:1">
                  1:1
                </button>
              </div>

              <!-- Fit / Fill Toggle -->
              <button id="video-fit-btn" type="button" class="px-2.5 py-1 text-xs font-semibold rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] shadow-xs transition-all" title="Toggle between Fit (no crop, 100% full view) and Fill">
                Fit (100% View)
              </button>

              <!-- Upload / Replace Video Button -->
              <label for="editor-video-upload-input" class="px-2.5 py-1 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs font-semibold text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] cursor-pointer transition-all flex items-center gap-1 shadow-xs" title="Upload or replace video">
                📁 Video
                <input id="editor-video-upload-input" type="file" accept="video/*,.mp4,.mov,.webm,.mkv,.m4v" class="sr-only" />
              </label>
            </div>
          </div>

          <!-- Video Canvas Container -->
          <div id="video-preview-wrapper" class="relative w-full max-h-[520px] aspect-[16/9] mx-auto bg-black rounded-2xl overflow-hidden shadow-l3 border border-[var(--color-hairline)] flex items-center justify-center group select-none transition-all duration-300">
            
            <!-- Native Video Element -->
            <video
              id="studio-video"
              class="w-full h-full object-contain max-h-[520px] block"
              playsinline
              preload="auto"
              crossorigin="anonymous"
            ></video>

            <!-- Canvas for subtitle rendering and video export -->
            <canvas id="studio-burn-canvas" class="hidden"></canvas>

            <!-- Social Media Safe Zone Overlays -->
