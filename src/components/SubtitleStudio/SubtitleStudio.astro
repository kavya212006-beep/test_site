<!-- Subtitle Studio Logic & Engine -->
<script>
  import { parseSubtitleText, parseWhisperResponse, serializeToSRT, serializeToVTT, serializeToASS, serializeToTXT, shiftSubtitleTimings, type SubtitleCue } from '../../utils/subtitleParser';
  import { extractAudioFromMedia } from '../../utils/audioExtractor';

  let currentCues: SubtitleCue[] = [];
  let originalCues: SubtitleCue[] = [];
  let currentPreset = 'hormozi';
  let syncOffset = 0;
  let videoBlobUrl = '';
  let activeVideoFile: File | null = null;
  let activeSubtitleFilename = '';

  // State for Burn Subtitles Dual Upload Mode
  let burnSelectedVideo: File | null = null;
  let burnSelectedSub: File | null = null;

  // Custom Typography State
  const typoState = {
    fontFamily: 'Outfit',
    fontSize: 28,
    baseColor: '#ffffff',
    highlightColor: '#facc15',
    strokeWidth: 0,
    backdropBox: 'none',
    textCase: 'uppercase',
    animMode: 'bounce',
    shadow: true,
  };

  // Toast Notification System
  function showToast(msg: string, type: 'success' | 'warning' | 'info' = 'info') {
    const toast = document.getElementById('studio-toast');
    const toastIcon = document.getElementById('studio-toast-icon');
    const toastMsg = document.getElementById('studio-toast-msg');
    if (!toast || !toastMsg || !toastIcon) return;

    toastIcon.textContent = type === 'success' ? '✓' : type === 'warning' ? '⚠️' : 'ℹ️';
    toastMsg.textContent = msg;

    toast.className = 'fixed top-6 right-6 z-50 max-w-md p-4 rounded-2xl shadow-2xl border transition-all flex items-center gap-3 ' +
      (type === 'success' ? 'bg-emerald-950/90 text-emerald-200 border-emerald-700 backdrop-blur-md' :
       type === 'warning' ? 'bg-amber-950/90 text-amber-200 border-amber-700 backdrop-blur-md' :
       'bg-[var(--color-canvas)] text-[var(--color-ink)] border-[var(--color-hairline)] backdrop-blur-md');

    toast.classList.remove('hidden');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 4500);
  }

  // Default demo cues
  const defaultDemoCues: SubtitleCue[] = [
    { id: 1, start: 0.0, end: 2.4, text: "Stop wasting hours typing subtitles manually." },
    { id: 2, start: 2.5, end: 5.2, text: "FreeAutoCaption gives you viral animated captions instantly." },
    { id: 3, start: 5.3, end: 8.0, text: "Upload your video, pick a style, and export watermark-free!" },
    { id: 4, start: 8.1, end: 11.5, text: "Boost your TikTok and Shorts retention by over 80%." }
  ];

  const uploadView = document.getElementById('studio-upload-view');
  const editorView = document.getElementById('studio-editor-view');
  const studioVideo = document.getElementById('studio-video') as HTMLVideoElement;
  const currentFileBadge = document.getElementById('current-file-badge');
  const currentSubBadge = document.getElementById('current-sub-badge');

  // Mode Switcher Elements
  const tabBtnAi = document.getElementById('mode-tab-ai');
  const tabBtnBurn = document.getElementById('mode-tab-burn');
  const viewModeAi = document.getElementById('view-mode-ai');
  const viewModeBurn = document.getElementById('view-mode-burn');

  function switchMode(mode: 'ai' | 'burn') {
    if (mode === 'ai') {
      tabBtnAi?.classList.add('bg-white', 'dark:bg-zinc-800', 'text-[var(--color-ink)]', 'shadow-sm');
      tabBtnAi?.classList.remove('text-[var(--color-mute)]');
      tabBtnBurn?.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-[var(--color-ink)]', 'shadow-sm');
      tabBtnBurn?.classList.add('text-[var(--color-mute)]');

      viewModeAi?.classList.remove('hidden');
      viewModeBurn?.classList.add('hidden');
    } else {
      tabBtnBurn?.classList.add('bg-white', 'dark:bg-zinc-800', 'text-[var(--color-ink)]', 'shadow-sm');
      tabBtnBurn?.classList.remove('text-[var(--color-mute)]');
      tabBtnAi?.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-[var(--color-ink)]', 'shadow-sm');
      tabBtnAi?.classList.add('text-[var(--color-mute)]');

      viewModeBurn?.classList.remove('hidden');
      viewModeAi?.classList.add('hidden');
    }
  }

  tabBtnAi?.addEventListener('click', () => switchMode('ai'));
  tabBtnBurn?.addEventListener('click', () => switchMode('burn'));

  // Initialize mode from dataset or URL query params
  const initialModeAttr = document.getElementById('subtitle-studio')?.getAttribute('data-initial-mode');
  const urlParams = new URLSearchParams(window.location.search);
  const modeParam = urlParams.get('mode');
  if (modeParam === 'burn' || initialModeAttr === 'burn') {
    switchMode('burn');
  }

  function showEditor() {
    uploadView?.classList.add('hidden');
    editorView?.classList.remove('hidden');
    editorView?.classList.add('flex');
