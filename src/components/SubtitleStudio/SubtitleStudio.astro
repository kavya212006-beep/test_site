---
import { t } from '../../i18n/utils';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const stylePresets = [
  { id: 'hormozi', nameKey: 'styles.hormozi', icon: '🔥', desc: 'Bold yellow pop, high-energy viral retention' },
  { id: 'beast', nameKey: 'styles.beast', icon: '⚡', desc: 'Thick black stroke with cyan bounce' },
  { id: 'cinematic', nameKey: 'styles.cinematic', icon: '🎬', desc: 'Frosted dark pill box for film & docs' },
  { id: 'neon', nameKey: 'styles.neon', icon: '💜', desc: 'Cyberpunk glowing cyan & pink neon' },
  { id: 'karaoke', nameKey: 'styles.karaoke', icon: '🎤', desc: 'Smooth progressive highlight sweep' },
  { id: 'minimal', nameKey: 'styles.minimal', icon: '✨', desc: 'Clean modern typography' },
];
---

<div id="subtitle-studio" class="w-full flex flex-col gap-8">

  <!-- Notification Toast Container -->
  <div id="studio-toast" class="hidden fixed top-6 right-6 z-50 max-w-md p-4 rounded-xl shadow-l3 border transition-all flex items-center gap-3">
    <span id="studio-toast-icon" class="text-xl"></span>
    <p id="studio-toast-msg" class="text-sm font-medium"></p>
  </div>

  <!-- ─── Studio Main Card ─────────────────────────────────── -->
  <div class="bg-[var(--color-canvas)] rounded-2xl border border-[var(--color-hairline)] shadow-l3 overflow-hidden">

    <!-- Top Workflow Tabs Bar -->
    <div class="flex items-center border-b border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] px-4 pt-3 overflow-x-auto scrollbar-hide gap-1" role="tablist">
      <button
        id="tab-btn-burn"
        role="tab"
        aria-selected="true"
        aria-controls="panel-burn"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-semibold border-b-2 border-[var(--color-ink)] text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>🔥</span>
        <span>{t(lang, 'studio.tab.burn')}</span>
        <span class="px-1.5 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded bg-[var(--color-ink)] text-[var(--color-canvas)]">Top</span>
      </button>

      <button
        id="tab-btn-audio"
        role="tab"
        aria-selected="false"
        aria-controls="panel-audio"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>🎙️</span>
        <span>{t(lang, 'studio.tab.audio')}</span>
        <span class="px-1.5 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded bg-[var(--color-grad-blue-start)]/10 text-[var(--color-grad-blue-start)]">Cloudflare AI</span>
      </button>

      <button
        id="tab-btn-script"
        role="tab"
        aria-selected="false"
        aria-controls="panel-script"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>📝</span>
        <span>{t(lang, 'studio.tab.script')}</span>
      </button>

      <button
        id="tab-btn-editor"
        role="tab"
        aria-selected="false"
        aria-controls="panel-editor"
        class="studio-tab-btn flex items-center gap-2 px-5 py-3 text-sm font-medium border-b-2 border-transparent text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-colors whitespace-nowrap -mb-px"
      >
        <span>🎬</span>
        <span>{t(lang, 'studio.tab.editor')}</span>
        <span class="ms-1 px-1.5 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded-md bg-[var(--color-link-bg-soft)] text-[var(--color-link)]">Live</span>
      </button>
    </div>

    <!-- ─── TAB 1: Video + Subtitle Burner (Upload Video & Subtitles) ─── -->
    <div id="panel-burn" role="tabpanel" class="p-6 md:p-8 flex flex-col gap-6">
      <div class="flex flex-col gap-1">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-[var(--color-link-bg-soft)] text-[var(--color-link)] uppercase tracking-wider">Fastest Workflow</span>
          <h3 class="display-sm text-[var(--color-ink)]">Upload Video & Subtitle File</h3>
        </div>
        <p class="text-sm text-[var(--color-body)]">Have a video file? Upload your video and subtitle file to sync, style, and burn them into high-res MP4 with zero watermark.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- 1. Video Dropzone -->
        <div class="flex flex-col gap-2">
          <label class="text-xs font-semibold text-[var(--color-ink)] uppercase tracking-wider">{t(lang, 'burn.upload.videoTitle')}</label>
          <label
            id="burn-video-dropzone"
            for="burn-video-input"
            class="flex flex-col items-center justify-center gap-3 w-full min-h-[190px] p-6 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-link)] hover:bg-[var(--color-link-bg-soft)]/40 rounded-2xl cursor-pointer transition-all group bg-[var(--color-canvas-soft)] relative text-center"
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
              🎥
            </div>
            <div>
              <p id="burn-video-name" class="text-sm font-semibold text-[var(--color-ink)]">Click to choose video or drop here</p>
              <p class="text-xs text-[var(--color-mute)] mt-0.5">{t(lang, 'burn.upload.videoSubtitle')}</p>
            </div>
            <input id="burn-video-input" type="file" accept="video/mp4,video/quicktime,video/webm,video/mkv,video/*" class="sr-only" />
          </label>
        </div>

        <!-- 2. Subtitle File Dropzone -->
        <div class="flex flex-col gap-2">
          <label class="text-xs font-semibold text-[var(--color-ink)] uppercase tracking-wider">{t(lang, 'burn.upload.subTitle')}</label>
          <label
            id="burn-sub-dropzone"
            for="burn-sub-input"
            class="flex flex-col items-center justify-center gap-3 w-full min-h-[190px] p-6 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-violet)] hover:bg-[var(--color-violet-soft)]/30 rounded-2xl cursor-pointer transition-all group bg-[var(--color-canvas-soft)] relative text-center"
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
              📄
            </div>
            <div>
              <p id="burn-sub-name" class="text-sm font-semibold text-[var(--color-ink)]">Click to upload .SRT, .VTT, .ASS</p>
              <p class="text-xs text-[var(--color-mute)] mt-0.5">{t(lang, 'burn.upload.subSubtitle')}</p>
            </div>
            <input id="burn-sub-input" type="file" accept=".srt,.vtt,.ass,.ssa,.sub,.json,.txt" class="sr-only" />
          </label>
        </div>
      </div>

      <!-- Quick Action / Auto-Transcribe Option -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
        <div class="flex items-center gap-3">
          <span class="text-xl">⚡</span>
          <p class="text-xs text-[var(--color-body)]">Don't have subtitles yet? <strong>Cloudflare Whisper AI</strong> can automatically extract and generate timestamped subtitles from your video audio.</p>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <button id="burn-auto-whisper-btn" type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-pill bg-[var(--color-link)] text-white text-sm font-semibold hover:opacity-90 transition-all shadow-l1 whitespace-nowrap">
            ⚡ Auto-Transcribe with Whisper
          </button>
          <button id="burn-start-btn" type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] text-sm font-semibold hover:opacity-90 transition-all shadow-l1 whitespace-nowrap">
            Open in Studio Editor →
          </button>
        </div>
      </div>
    </div>

    <!-- ─── TAB 2: AI Audio / Video Transcriber (Whisper Edge GPU) ─── -->
    <div id="panel-audio" role="tabpanel" class="hidden p-6 md:p-8 flex-col gap-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-[var(--color-grad-blue-start)]/10 text-[var(--color-grad-blue-start)] uppercase tracking-wider">Cloudflare Whisper AI</span>
            <h3 class="display-sm text-[var(--color-ink)]">{t(lang, 'studio.tab.audio')}</h3>
          </div>
          <p class="text-sm text-[var(--color-body)]">{t(lang, 'audio.drop.formats')}</p>
        </div>

        <!-- Spoken Language Selector -->
        <div class="flex items-center gap-2 shrink-0">
          <label for="whisper-lang-select" class="text-xs font-semibold text-[var(--color-mute)] uppercase tracking-wider">Language:</label>
          <select
            id="whisper-lang-select"
            class="px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-link)] transition-all cursor-pointer"
          >
            <option value="auto">🌐 Auto-Detect Language</option>
            <option value="en">🇺🇸 English</option>
            <option value="es">🇪🇸 Spanish (Español)</option>
            <option value="fr">🇫🇷 French (Français)</option>
            <option value="de">🇩🇪 German (Deutsch)</option>
            <option value="pt">🇧🇷 Portuguese (Português)</option>
            <option value="ja">🇯🇵 Japanese (日本語)</option>
            <option value="zh">🇨🇳 Chinese (中文)</option>
            <option value="ar">🇸🇦 Arabic (العربية)</option>
            <option value="it">🇮🇹 Italian (Italiano)</option>
            <option value="hi">🇮🇳 Hindi (हिन्दी)</option>
          </select>
        </div>
      </div>

      <!-- Drag & Drop Upload Zone -->
      <label
        id="audio-dropzone"
        for="media-file-input"
        class="flex flex-col items-center justify-center gap-4 w-full min-h-[220px] p-6 border-2 border-dashed border-[var(--color-hairline)] hover:border-[var(--color-link)] hover:bg-[var(--color-link-bg-soft)] rounded-2xl cursor-pointer transition-all group relative bg-[var(--color-canvas-soft)] text-center"
      >
        <div class="w-16 h-16 rounded-2xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] shadow-l1 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
          🎙️
        </div>
        <div>
          <p class="text-base font-semibold text-[var(--color-ink)]">{t(lang, 'audio.drop.title')}</p>
          <p class="text-xs text-[var(--color-mute)] mt-1">{t(lang, 'audio.drop.subtitle')}</p>
        </div>

        <input
          id="media-file-input"
          type="file"
          accept="audio/*,video/*,.mp4,.mov,.webm,.mkv,.mp3,.wav,.m4a"
          class="sr-only"
        />

        <!-- Loading Overlay -->
        <div id="transcribe-loading" class="hidden absolute inset-0 bg-[var(--color-canvas)]/95 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center gap-4 z-20">
          <div class="flex items-center gap-1.5 h-8">
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-1 h-6 animate-pulse"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-2 h-8 animate-pulse"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-3 h-4 animate-pulse"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-4 h-7 animate-pulse"></div>
            <div class="w-1.5 bg-[var(--color-link)] rounded-full waveform-bar-5 h-5 animate-pulse"></div>
          </div>
          <p id="transcribe-status-text" class="text-sm font-semibold text-[var(--color-ink)] animate-pulse">{t(lang, 'audio.analyzing')}</p>
        </div>
      </label>

      <!-- Live Voice AI Recording & Demo Samples -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-medium text-[var(--color-mute)] uppercase tracking-wider">{t(lang, 'audio.sample.heading')}</span>
          <button class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all" data-sample="podcast">
            {t(lang, 'audio.sample.podcast')}
          </button>
          <button class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all" data-sample="motivation">
            {t(lang, 'audio.sample.motivation')}
          </button>
          <button class="sample-audio-btn px-3 py-1.5 text-xs font-medium rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:border-[var(--color-hairline-strong)] hover:shadow-l1 transition-all" data-sample="tutorial">
            {t(lang, 'audio.sample.tutorial')}
          </button>
        </div>

        <button
          id="live-speech-btn"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:opacity-85 transition-all shadow-l1 shrink-0"
        >
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <span>Record Live Mic</span>
        </button>
      </div>
    </div>

    <!-- ─── TAB 3: Script to Subtitles ───────────────────────── -->
    <div id="panel-script" role="tabpanel" class="hidden p-6 md:p-8 flex-col gap-6">
      <div class="flex flex-col gap-1">
        <h3 class="display-sm text-[var(--color-ink)]">{t(lang, 'script.title')}</h3>
        <p class="text-sm text-[var(--color-body)]">{t(lang, 'script.subtitle')}</p>
      </div>

      <div class="relative">
        <textarea
          id="script-input"
          rows="6"
          placeholder={t(lang, 'script.placeholder')}
          class="w-full p-4 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-[var(--color-ink)] text-sm font-mono focus:outline-none focus:border-[var(--color-link)] focus:ring-2 focus:ring-[var(--color-link-bg-soft)] transition-all resize-y"
        ></textarea>
        <button
          id="insert-sample-script"
          type="button"
          class="absolute top-3 right-3 px-3 py-1.5 text-xs font-medium rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] shadow-xs transition-all"
        >
          {t(lang, 'script.sampleBtn')}
        </button>
      </div>

      <!-- Pacing & Segmentation Controls -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-medium text-[var(--color-body)]">{t(lang, 'script.wpm')}</span>
            <span id="wpm-display" class="font-bold text-[var(--color-ink)]">145 WPM</span>
          </div>
          <input
            id="wpm-slider"
            type="range"
            min="90"
            max="220"
            value="145"
            class="w-full accent-[var(--color-link)] cursor-pointer"
          />
        </div>

        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-medium text-[var(--color-body)]">{t(lang, 'script.wordsPerLine')}</span>
            <span id="wpl-display" class="font-bold text-[var(--color-ink)]">4 words (Viral)</span>
          </div>
          <input
            id="wpl-slider"
            type="range"
            min="1"
            max="10"
            value="4"
            class="w-full accent-[var(--color-link)] cursor-pointer"
          />
        </div>
      </div>

      <button
        id="generate-from-script-btn"
        type="button"
        class="self-start px-6 py-3 rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] text-sm font-semibold hover:opacity-90 transition-all shadow-l1"
      >
        {t(lang, 'script.generateBtn')} →
      </button>
    </div>

    <!-- ─── TAB 4: Live Video Studio & Editor (Canvas / Burner) ─── -->
    <div id="panel-editor" role="tabpanel" class="hidden p-6 md:p-8 flex-col gap-8">
      
      <!-- Studio Grid: Video Player + Controls -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Left Column: Video Preview Player & Canvas -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <h4 class="text-sm font-semibold text-[var(--color-ink)]">{t(lang, 'editor.heading')}</h4>
              <button id="editor-rewhisper-btn" type="button" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-[var(--color-link-bg-soft)] text-[var(--color-link)] hover:bg-[var(--color-link)] hover:text-white transition-all">
                ⚡ Auto-Transcribe with Whisper
              </button>
            </div>
            
            <!-- Aspect Ratio Selector -->
            <div class="flex items-center gap-1.5 p-1 rounded-lg bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs">
              <button class="aspect-btn px-2.5 py-1 rounded font-medium text-[var(--color-ink)] bg-[var(--color-canvas)] shadow-xs transition-all" data-aspect="9:16">
                9:16 Shorts
              </button>
              <button class="aspect-btn px-2.5 py-1 rounded font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="16:9">
                16:9 YT
              </button>
              <button class="aspect-btn px-2.5 py-1 rounded font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)] transition-all" data-aspect="1:1">
                1:1 Square
              </button>
            </div>
          </div>

          <!-- Video Canvas Container -->
          <div id="video-preview-wrapper" class="relative w-full aspect-[9/16] max-h-[520px] mx-auto bg-black rounded-2xl overflow-hidden shadow-l3 border border-[var(--color-hairline)] flex items-center justify-center group select-none">
            
            <!-- Native Video Element -->
            <video
              id="studio-video"
              class="w-full h-full object-cover"
              playsinline
              preload="auto"
              crossorigin="anonymous"
            ></video>

            <!-- Canvas for subtitle rendering and video export -->
            <canvas id="studio-burn-canvas" class="hidden"></canvas>

            <!-- Social Media Safe Zone Overlays -->
            <div id="safe-zone-tiktok" class="hidden absolute inset-0 pointer-events-none border-2 border-dashed border-red-400/40 m-4 flex flex-col justify-between p-3 z-10">
              <div class="text-[10px] font-mono text-red-300/80 bg-black/60 px-1.5 py-0.5 rounded self-start">TikTok Safe Top</div>
              <div class="text-[10px] font-mono text-red-300/80 bg-black/60 px-1.5 py-0.5 rounded self-end">TikTok Right UI Safe</div>
              <div class="text-[10px] font-mono text-red-300/80 bg-black/60 px-1.5 py-0.5 rounded self-start">TikTok Caption Bounds</div>
            </div>

            <div id="safe-zone-reels" class="hidden absolute inset-0 pointer-events-none border-2 border-dashed border-purple-400/40 m-4 flex flex-col justify-between p-3 z-10">
              <div class="text-[10px] font-mono text-purple-300/80 bg-black/60 px-1.5 py-0.5 rounded self-start">IG Reels Safe Top</div>
              <div class="text-[10px] font-mono text-purple-300/80 bg-black/60 px-1.5 py-0.5 rounded self-end">Reels Icons</div>
              <div class="text-[10px] font-mono text-purple-300/80 bg-black/60 px-1.5 py-0.5 rounded self-start">Audio Label Safe</div>
            </div>

            <!-- Live Subtitle Overlay Layer -->
            <div id="subtitle-overlay" class="absolute inset-x-0 bottom-16 flex flex-col items-center justify-center p-4 pointer-events-none z-10 text-center transition-all">
              <div id="subtitle-render-box" class="subtitle-style-hormozi font-extrabold text-2xl tracking-tight transition-transform">
                <span>FreeAutoCaption Studio</span>
              </div>
            </div>

            <!-- Custom Play/Pause Overlay Button -->
            <button
              id="video-play-btn"
              type="button"
              class="absolute inset-0 flex items-center justify-center bg-black/30 hover:bg-black/20 text-white text-4xl transition-all cursor-pointer z-10"
              aria-label="Play video"
            >
              <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/30 shadow-l2 group-hover:scale-110 transition-transform">
                ▶
              </div>
            </button>
          </div>

          <!-- Video Playback & Seek Bar -->
          <div class="flex items-center gap-3 p-3 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
            <button id="ctrl-play-pause" type="button" class="p-2 rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)] transition-colors" aria-label="Play/Pause">
              ▶
            </button>
            <input
              id="ctrl-seekbar"
              type="range"
              min="0"
              max="100"
              value="0"
              step="0.1"
              class="flex-1 accent-[var(--color-link)] cursor-pointer"
            />
            <span id="ctrl-time-display" class="text-xs font-mono text-[var(--color-body)] min-w-[75px] text-right">
              00:00 / 00:00
            </span>
          </div>

          <!-- Video Options Bar: Safe Zones & Positioning -->
          <div class="grid grid-cols-2 gap-3 p-3 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] text-xs">
            <div class="flex flex-col gap-1">
              <span class="font-medium text-[var(--color-body)]">{t(lang, 'editor.safezones')}</span>
              <select id="safezone-select" class="p-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] text-xs">
                <option value="none">None (Full Canvas)</option>
                <option value="tiktok">TikTok / Shorts Safe Zone</option>
                <option value="reels">Instagram Reels Safe Zone</option>
              </select>
            </div>
            <div class="flex flex-col gap-1">
              <span class="font-medium text-[var(--color-body)]">{t(lang, 'editor.position')}</span>
              <select id="position-select" class="p-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-ink)] text-xs">
                <option value="bottom">Bottom (80%) - Standard</option>
                <option value="center">Center - High Focus</option>
                <option value="top">Top (20%) - Title/Hook</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Right Column: Style Presets, Timing Sync & Subtitle Cues Timeline -->
        <div class="lg:col-span-5 flex flex-col gap-6">
          
          <!-- 1. Style Preset Selector -->
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-ink)]">{t(lang, 'styles.heading')}</span>
              <span class="text-[11px] text-[var(--color-link)] font-medium">6 Viral Styles</span>
            </div>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              {stylePresets.map(preset => (
                <button
                  type="button"
                  class="style-preset-btn flex flex-col items-center justify-center p-3 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:border-[var(--color-link)] hover:bg-[var(--color-canvas)] transition-all text-center gap-1 group"
                  data-preset={preset.id}
                >
                  <span class="text-xl group-hover:scale-110 transition-transform">{preset.icon}</span>
                  <span class="text-xs font-bold text-[var(--color-ink)]">{t(lang, preset.nameKey)}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- 2. Millisecond Precision Sync & Drift Control -->
          <div class="flex flex-col gap-3 p-4 rounded-xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-ink)]">{t(lang, 'sync.heading')}</span>
              <span id="sync-offset-display" class="text-xs font-mono font-bold text-[var(--color-link)]">+0.00s</span>
            </div>
            <p class="text-[11px] text-[var(--color-mute)] leading-relaxed">{t(lang, 'sync.desc')}</p>

            <div class="flex items-center gap-2">
              <button id="sync-minus-btn" type="button" class="px-3 py-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs font-bold hover:bg-[var(--color-canvas-soft-2)]">
                -0.2s
              </button>
              <input
                id="sync-offset-slider"
                type="range"
                min="-5"
                max="5"
                step="0.05"
                value="0"
                class="flex-1 accent-[var(--color-link)] cursor-pointer"
              />
              <button id="sync-plus-btn" type="button" class="px-3 py-1.5 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas)] text-xs font-bold hover:bg-[var(--color-canvas-soft-2)]">
                +0.2s
              </button>
              <button id="sync-reset-btn" type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-[var(--color-mute)] hover:text-[var(--color-ink)]">
                Reset
              </button>
            </div>
          </div>

          <!-- 3. Subtitle Timeline & Cue Editor -->
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-ink)]">Subtitle Cues Timeline</span>
                <span id="cue-count-badge" class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-[var(--color-canvas-soft-2)] text-[var(--color-ink)]">0 cues</span>
              </div>
              <button id="add-cue-btn" type="button" class="text-xs font-semibold text-[var(--color-link)] hover:underline">
                + Add Cue
              </button>
            </div>

            <!-- Scrollable Cues List -->
            <div id="cues-container" class="flex flex-col gap-2 max-h-[220px] overflow-y-auto pr-1">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- 4. Export & Download Actions -->
          <div class="flex flex-col gap-3 pt-2 border-t border-[var(--color-hairline)]">
            <button
              id="export-burned-video-btn"
              type="button"
              class="w-full py-3.5 px-6 rounded-pill bg-[var(--color-ink)] text-[var(--color-on-primary)] font-bold text-sm hover:opacity-90 transition-all shadow-l2 flex items-center justify-center gap-2"
            >
              <span>🎬</span>
              <span>Export High-Res MP4 (Burned Subtitles)</span>
            </button>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
              <button id="export-srt-btn" type="button" class="p-2 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] text-[var(--color-ink)] font-semibold transition-colors text-center">
                ⬇️ Download .SRT
              </button>
              <button id="export-vtt-btn" type="button" class="p-2 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] text-[var(--color-ink)] font-semibold transition-colors text-center">
                ⬇️ Download .VTT
              </button>
              <button id="export-ass-btn" type="button" class="p-2 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] text-[var(--color-ink)] font-semibold transition-colors text-center">
                ⬇️ Download .ASS
              </button>
              <button id="export-copy-btn" type="button" class="p-2 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] hover:bg-[var(--color-canvas)] text-[var(--color-ink)] font-semibold transition-colors text-center">
                📋 Copy Text
              </button>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

</div>

<!-- Subtitle Studio Logic & Engine -->
<script>
  import { parseSubtitleText, parseWhisperResponse, serializeToSRT, serializeToVTT, serializeToASS, serializeToTXT, shiftSubtitleTimings, type SubtitleCue } from '../../utils/subtitleParser';
  import { extractAudioFromMedia } from '../../utils/audioExtractor';

  let currentCues: SubtitleCue[] = [];
  let originalCues: SubtitleCue[] = [];
  let currentPreset = 'hormozi';
  let syncOffset = 0;
  let videoBlobUrl = '';
  let activeVideoFile: File | null = null;

  // Toast Notification System
  function showToast(msg: string, type: 'success' | 'warning' | 'info' = 'info') {
    const toast = document.getElementById('studio-toast');
    const toastIcon = document.getElementById('studio-toast-icon');
    const toastMsg = document.getElementById('studio-toast-msg');
    if (!toast || !toastMsg || !toastIcon) return;

    toastIcon.textContent = type === 'success' ? '✓' : type === 'warning' ? '⚠️' : 'ℹ️';
    toastMsg.textContent = msg;

    toast.className = 'fixed top-6 right-6 z-50 max-w-md p-4 rounded-xl shadow-l3 border transition-all flex items-center gap-3 ' +
      (type === 'success' ? 'bg-emerald-950/90 text-emerald-200 border-emerald-700 backdrop-blur-md' :
       type === 'warning' ? 'bg-amber-950/90 text-amber-200 border-amber-700 backdrop-blur-md' :
       'bg-[var(--color-canvas)] text-[var(--color-ink)] border-[var(--color-hairline)] backdrop-blur-md');

    toast.classList.remove('hidden');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 4500);
  }

  // Default demo cues
  const defaultDemoCues: SubtitleCue[] = [
    { id: 1, start: 0.0, end: 2.4, text: "Stop wasting hours typing subtitles manually." },
    { id: 2, start: 2.5, end: 5.2, text: "FreeAutoCaption gives you viral animated captions instantly." },
    { id: 3, start: 5.3, end: 8.0, text: "Upload your video, pick a style, and export watermark-free!" },
    { id: 4, start: 8.1, end: 11.5, text: "Boost your TikTok and Shorts retention by over 80%." }
  ];

  // Tab switching logic
  const tabBtns = document.querySelectorAll('.studio-tab-btn');
  const panels = {
    'burn': document.getElementById('panel-burn'),
    'audio': document.getElementById('panel-audio'),
    'script': document.getElementById('panel-script'),
    'editor': document.getElementById('panel-editor'),
  };

  function switchTab(targetTab: 'burn' | 'audio' | 'script' | 'editor') {
    tabBtns.forEach(btn => {
      const isSelected = btn.id === `tab-btn-${targetTab}`;
      btn.setAttribute('aria-selected', String(isSelected));
      if (isSelected) {
        btn.classList.add('border-[var(--color-ink)]', 'text-[var(--color-ink)]', 'font-semibold');
        btn.classList.remove('border-transparent', 'text-[var(--color-mute)]', 'font-medium');
      } else {
        btn.classList.remove('border-[var(--color-ink)]', 'text-[var(--color-ink)]', 'font-semibold');
        btn.classList.add('border-transparent', 'text-[var(--color-mute)]', 'font-medium');
      }
    });

    Object.entries(panels).forEach(([key, panel]) => {
      if (panel) {
        if (key === targetTab) {
          panel.classList.remove('hidden');
          panel.classList.add('flex');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('flex');
        }
      }
    });

    if (targetTab === 'editor') {
      renderCuesList();
    }
  }

  document.getElementById('tab-btn-burn')?.addEventListener('click', () => switchTab('burn'));
  document.getElementById('tab-btn-audio')?.addEventListener('click', () => switchTab('audio'));
  document.getElementById('tab-btn-script')?.addEventListener('click', () => switchTab('script'));
  document.getElementById('tab-btn-editor')?.addEventListener('click', () => switchTab('editor'));

  // Video & Subtitle Burner Handlers
  const burnVideoInput = document.getElementById('burn-video-input') as HTMLInputElement;
  const burnSubInput = document.getElementById('burn-sub-input') as HTMLInputElement;
  const burnVideoName = document.getElementById('burn-video-name');
  const burnSubName = document.getElementById('burn-sub-name');
  const studioVideo = document.getElementById('studio-video') as HTMLVideoElement;

  function loadVideoToPlayer(file: File) {
    activeVideoFile = file;
    if (videoBlobUrl) URL.revokeObjectURL(videoBlobUrl);
    videoBlobUrl = URL.createObjectURL(file);
    studioVideo.src = videoBlobUrl;
    studioVideo.load();
    if (burnVideoName) burnVideoName.textContent = `✓ ${file.name}`;
  }

  burnVideoInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) loadVideoToPlayer(file);
  });

  burnSubInput?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const text = await file.text();
      const cues = parseSubtitleText(text, file.name);
      if (cues.length > 0) {
        originalCues = [...cues];
        currentCues = [...cues];
        if (burnSubName) burnSubName.textContent = `✓ ${file.name} (${cues.length} cues)`;
        showToast(`✓ Loaded ${cues.length} cues from ${file.name}`, 'success');
      }
    }
  });

  document.getElementById('burn-start-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) {
      currentCues = [...defaultDemoCues];
      originalCues = [...defaultDemoCues];
    }
    switchTab('editor');
  });

  document.getElementById('burn-auto-whisper-btn')?.addEventListener('click', () => {
    if (activeVideoFile) {
      transcribeMediaFile(activeVideoFile);
    } else {
      burnVideoInput?.click();
    }
  });

  document.getElementById('editor-rewhisper-btn')?.addEventListener('click', () => {
    if (activeVideoFile) {
      transcribeMediaFile(activeVideoFile);
    } else {
      mediaFileInput?.click();
    }
  });

  // Core Cloudflare Whisper AI Audio/Video Transcriber
  const mediaFileInput = document.getElementById('media-file-input') as HTMLInputElement;
  const transcribeLoading = document.getElementById('transcribe-loading');
  const transcribeStatusText = document.getElementById('transcribe-status-text');
  const whisperLangSelect = document.getElementById('whisper-lang-select') as HTMLSelectElement;

  async function transcribeMediaFile(file: File) {
    if (!file) return;

    if (file.type.startsWith('video/') || file.name.match(/\.(mp4|mov|webm|mkv|avi|m4v)$/i)) {
      loadVideoToPlayer(file);
    }

    transcribeLoading?.classList.remove('hidden');

    try {
      if (transcribeStatusText) transcribeStatusText.textContent = 'Extracting audio track from media in browser...';

      const extraction = await extractAudioFromMedia(file, (pct, status) => {
        if (transcribeStatusText) transcribeStatusText.textContent = `${status} (${pct}%)`;
      });

      const { chunks, duration } = extraction;
      const selectedLanguage = whisperLangSelect?.value || 'auto';
      const allExtractedCues: SubtitleCue[] = [];

      for (let i = 0; i < chunks.length; i++) {
        const chunk = chunks[i];
        if (transcribeStatusText) {
          transcribeStatusText.textContent = chunks.length > 1
            ? `Cloudflare Whisper AI: Transcribing part ${i + 1} of ${chunks.length} (${Math.round(chunk.startSec)}s - ${Math.round(chunk.endSec)}s)...`
            : `Cloudflare Whisper AI: Transcribing speech with GPU acceleration...`;
        }

        const headers: Record<string, string> = {
          'Content-Type': 'audio/wav',
          'X-Audio-Offset': String(chunk.startSec),
        };
        if (selectedLanguage && selectedLanguage !== 'auto') {
          headers['X-Language'] = selectedLanguage;
        }

        const response = await fetch('/api/transcribe', {
          method: 'POST',
          headers,
          body: chunk.blob,
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.message || errData.error || `Whisper API failed with HTTP ${response.status}`);
        }

        const data = await response.json();
        const parsed = parseWhisperResponse(data, chunk.startSec);
        if (parsed.length > 0) {
          allExtractedCues.push(...parsed);
        }
      }

      if (allExtractedCues.length > 0) {
        currentCues = allExtractedCues.map((c, idx) => ({ ...c, id: idx + 1 }));
        originalCues = [...currentCues];
        showToast(`✓ Cloudflare Whisper AI successfully transcribed ${currentCues.length} subtitle cues!`, 'success');
      } else {
        throw new Error('No spoken words were recognized in the audio file.');
      }
    } catch (err: any) {
      console.warn('Whisper transcription notice:', err);
      showToast(`Notice: ${err?.message || 'Could not complete AI transcription.'}`, 'warning');
      if (currentCues.length === 0) {
        currentCues = [...defaultDemoCues];
        originalCues = [...defaultDemoCues];
      }
    } finally {
      transcribeLoading?.classList.add('hidden');
      switchTab('editor');
    }
  }

  mediaFileInput?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) transcribeMediaFile(file);
  });

  // Demo audio sample buttons
  document.querySelectorAll('.sample-audio-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentCues = [...defaultDemoCues];
      originalCues = [...defaultDemoCues];
      showToast('✓ Loaded sample demo subtitles', 'info');
      switchTab('editor');
    });
  });

  // Live Speech Recognition Web API Fallback
  const liveSpeechBtn = document.getElementById('live-speech-btn');
  let isRecording = false;
  let recognition: any = null;

  if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
    const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;

    let startTime = 0;
    recognition.onresult = (event: any) => {
      const results = event.results;
      const transcript = results[results.length - 1][0].transcript;
      const now = (Date.now() - startTime) / 1000;
      
      if (results[results.length - 1].isFinal) {
        currentCues.push({
          id: currentCues.length + 1,
          start: Math.max(0, now - 2.5),
          end: now,
          text: transcript.trim(),
        });
        originalCues = [...currentCues];
        renderCuesList();
      }
    };
  }

  liveSpeechBtn?.addEventListener('click', () => {
    if (!recognition) {
      showToast('Speech recognition is not supported in this browser. Please use Chrome/Edge or upload audio directly.', 'warning');
      return;
    }
    if (!isRecording) {
      recognition.start();
      isRecording = true;
      liveSpeechBtn.classList.add('bg-red-600');
      liveSpeechBtn.innerHTML = '<span>⏹️ Stop Recording</span>';
    } else {
      recognition.stop();
      isRecording = false;
      liveSpeechBtn.classList.remove('bg-red-600');
      liveSpeechBtn.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span><span>Record Live Mic</span>';
      switchTab('editor');
    }
  });

  // Script Auto-Sync Generator
  const scriptInput = document.getElementById('script-input') as HTMLTextAreaElement;
  const insertSampleScript = document.getElementById('insert-sample-script');
  const wpmSlider = document.getElementById('wpm-slider') as HTMLInputElement;
  const wplSlider = document.getElementById('wpl-slider') as HTMLInputElement;
  const wpmDisplay = document.getElementById('wpm-display');
  const wplDisplay = document.getElementById('wpl-display');

  insertSampleScript?.addEventListener('click', () => {
    if (scriptInput) {
      scriptInput.value = "Hey everyone! Today I'm going to show you the fastest way to auto-generate viral subtitles for TikTok and YouTube Shorts. You don't need expensive editing tools or complex timelines. Simply upload your video, pick your favorite punchy animation style, and download in seconds!";
    }
  });

  wpmSlider?.addEventListener('input', () => {
    if (wpmDisplay) wpmDisplay.textContent = `${wpmSlider.value} WPM`;
  });

  wplSlider?.addEventListener('input', () => {
    if (wplDisplay) wplDisplay.textContent = `${wplSlider.value} words (${wplSlider.value === '4' ? 'Viral' : 'Custom'})`;
  });

  document.getElementById('generate-from-script-btn')?.addEventListener('click', () => {
    const text = scriptInput?.value.trim();
    if (!text) {
      showToast('Please enter or paste your script first.', 'warning');
      return;
    }

    const words = text.split(/\s+/).filter(Boolean);
    const wpm = parseInt(wpmSlider?.value || '145', 10);
    const wordsPerLine = parseInt(wplSlider?.value || '4', 10);
    const secondsPerWord = 60 / wpm;

    const cues: SubtitleCue[] = [];
    let currentTime = 0;

    for (let i = 0; i < words.length; i += wordsPerLine) {
      const chunk = words.slice(i, i + wordsPerLine).join(' ');
      const duration = chunk.split(/\s+/).length * secondsPerWord;
      cues.push({
        id: cues.length + 1,
        start: parseFloat(currentTime.toFixed(2)),
        end: parseFloat((currentTime + duration).toFixed(2)),
        text: chunk,
      });
      currentTime += duration + 0.1;
    }

    currentCues = cues;
    originalCues = [...cues];
    showToast(`✓ Generated ${cues.length} subtitle cues from script!`, 'success');
    switchTab('editor');
  });

  // Video Studio Player & Overlay Rendering
  const subtitleRenderBox = document.getElementById('subtitle-render-box');
  const videoPlayBtn = document.getElementById('video-play-btn');
  const ctrlPlayPause = document.getElementById('ctrl-play-pause');
  const ctrlSeekbar = document.getElementById('ctrl-seekbar') as HTMLInputElement;
  const ctrlTimeDisplay = document.getElementById('ctrl-time-display');
  const cueCountBadge = document.getElementById('cue-count-badge');
  const cuesContainer = document.getElementById('cues-container');

  function updateSubtitleAtTime(time: number) {
    if (!subtitleRenderBox) return;

    const activeCue = currentCues.find(c => time >= c.start && time <= c.end);
    if (activeCue) {
      subtitleRenderBox.textContent = activeCue.text;
      subtitleRenderBox.style.opacity = '1';
    } else {
      subtitleRenderBox.textContent = '';
      subtitleRenderBox.style.opacity = '0';
    }
  }

  studioVideo?.addEventListener('timeupdate', () => {
    const time = studioVideo.currentTime;
    const duration = studioVideo.duration || 12;
    if (ctrlSeekbar && duration > 0) {
      ctrlSeekbar.value = String((time / duration) * 100);
    }
    if (ctrlTimeDisplay) {
      const formatSec = (s: number) => {
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
      };
      ctrlTimeDisplay.textContent = `${formatSec(time)} / ${formatSec(duration)}`;
    }
    updateSubtitleAtTime(time);
  });

  function togglePlay() {
    if (!studioVideo) return;
    if (studioVideo.paused) {
      studioVideo.play();
      if (videoPlayBtn) videoPlayBtn.classList.add('hidden');
      if (ctrlPlayPause) ctrlPlayPause.textContent = '⏸';
    } else {
      studioVideo.pause();
      if (videoPlayBtn) videoPlayBtn.classList.remove('hidden');
      if (ctrlPlayPause) ctrlPlayPause.textContent = '▶';
    }
  }

  videoPlayBtn?.addEventListener('click', togglePlay);
  ctrlPlayPause?.addEventListener('click', togglePlay);

  ctrlSeekbar?.addEventListener('input', () => {
    const duration = studioVideo?.duration || 12;
    const target = (parseFloat(ctrlSeekbar.value) / 100) * duration;
    if (studioVideo) studioVideo.currentTime = target;
    updateSubtitleAtTime(target);
  });

  // Aspect Ratio Switcher
  document.querySelectorAll('.aspect-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.aspect-btn').forEach(b => {
        b.classList.remove('bg-[var(--color-canvas)]', 'text-[var(--color-ink)]', 'shadow-xs');
        b.classList.add('text-[var(--color-mute)]');
      });
      btn.classList.add('bg-[var(--color-canvas)]', 'text-[var(--color-ink)]', 'shadow-xs');
      btn.classList.remove('text-[var(--color-mute)]');

      const aspect = btn.getAttribute('data-aspect');
      const wrapper = document.getElementById('video-preview-wrapper');
      if (wrapper) {
        wrapper.classList.remove('aspect-[9/16]', 'aspect-[16/9]', 'aspect-square');
        if (aspect === '9:16') wrapper.classList.add('aspect-[9/16]');
        else if (aspect === '16:9') wrapper.classList.add('aspect-[16/9]');
        else if (aspect === '1:1') wrapper.classList.add('aspect-square');
      }
    });
  });

  // Safe Zones
  const safezoneSelect = document.getElementById('safezone-select') as HTMLSelectElement;
  safezoneSelect?.addEventListener('change', () => {
    const val = safezoneSelect.value;
    const tt = document.getElementById('safe-zone-tiktok');
    const reels = document.getElementById('safe-zone-reels');
    tt?.classList.add('hidden');
    reels?.classList.add('hidden');
    if (val === 'tiktok') tt?.classList.remove('hidden');
    if (val === 'reels') reels?.classList.remove('hidden');
  });

  // Position
  const positionSelect = document.getElementById('position-select') as HTMLSelectElement;
  positionSelect?.addEventListener('change', () => {
    const overlay = document.getElementById('subtitle-overlay');
    if (!overlay) return;
    overlay.classList.remove('bottom-16', 'top-16', 'inset-y-0');
    if (positionSelect.value === 'bottom') overlay.classList.add('bottom-16');
    else if (positionSelect.value === 'top') overlay.classList.add('top-16');
    else if (positionSelect.value === 'center') overlay.classList.add('inset-y-0');
  });

  // Style Preset Selection
  document.querySelectorAll('.style-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = btn.getAttribute('data-preset') || 'hormozi';
      currentPreset = preset;
      if (subtitleRenderBox) {
        subtitleRenderBox.className = `subtitle-style-${preset} font-extrabold text-2xl tracking-tight transition-transform`;
      }
    });
  });

  // Sync Offset & Drift Adjuster
  const syncOffsetSlider = document.getElementById('sync-offset-slider') as HTMLInputElement;
  const syncOffsetDisplay = document.getElementById('sync-offset-display');
  const syncResetBtn = document.getElementById('sync-reset-btn');
  const syncMinusBtn = document.getElementById('sync-minus-btn');
  const syncPlusBtn = document.getElementById('sync-plus-btn');

  function applySyncOffset(offsetVal: number) {
    syncOffset = offsetVal;
    if (syncOffsetSlider) syncOffsetSlider.value = String(offsetVal);
    if (syncOffsetDisplay) {
      const sign = offsetVal >= 0 ? '+' : '';
      syncOffsetDisplay.textContent = `${sign}${offsetVal.toFixed(2)}s`;
    }
    currentCues = shiftSubtitleTimings(originalCues, offsetVal * 1000);
    renderCuesList();
  }

  syncOffsetSlider?.addEventListener('input', () => applySyncOffset(parseFloat(syncOffsetSlider.value)));
  syncMinusBtn?.addEventListener('click', () => applySyncOffset(parseFloat((syncOffset - 0.2).toFixed(2))));
  syncPlusBtn?.addEventListener('click', () => applySyncOffset(parseFloat((syncOffset + 0.2).toFixed(2))));
  syncResetBtn?.addEventListener('click', () => applySyncOffset(0));

  // Render Cues Timeline List
  function renderCuesList() {
    if (cueCountBadge) cueCountBadge.textContent = `${currentCues.length} cues`;
    if (!cuesContainer) return;

    cuesContainer.innerHTML = '';
    currentCues.forEach((cue, idx) => {
      const item = document.createElement('div');
      item.className = 'flex items-center gap-2 p-2 rounded-lg bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs';
      item.innerHTML = `
        <span class="text-[10px] font-mono text-[var(--color-mute)] shrink-0 w-5">#${idx + 1}</span>
        <input type="number" step="0.1" value="${cue.start}" class="cue-start-input w-14 px-1.5 py-1 text-[11px] font-mono rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-center" data-idx="${idx}" />
        <span class="text-[10px] text-[var(--color-mute)]">→</span>
        <input type="number" step="0.1" value="${cue.end}" class="cue-end-input w-14 px-1.5 py-1 text-[11px] font-mono rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-center" data-idx="${idx}" />
        <input type="text" value="${cue.text.replace(/"/g, '&quot;')}" class="cue-text-input flex-1 px-2 py-1 text-xs rounded border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-medium" data-idx="${idx}" />
        <button class="cue-del-btn text-red-500 hover:text-red-700 px-1 font-bold" data-idx="${idx}">✕</button>
      `;
      cuesContainer.appendChild(item);
    });

    // Cue input events
    cuesContainer.querySelectorAll('.cue-start-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues[idx].start = parseFloat((e.target as HTMLInputElement).value) || 0;
      });
    });

    cuesContainer.querySelectorAll('.cue-end-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues[idx].end = parseFloat((e.target as HTMLInputElement).value) || 0;
      });
    });

    cuesContainer.querySelectorAll('.cue-text-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues[idx].text = (e.target as HTMLInputElement).value;
      });
    });

    cuesContainer.querySelectorAll('.cue-del-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues.splice(idx, 1);
        originalCues = [...currentCues];
        renderCuesList();
      });
    });
  }

  // Add new cue
  document.getElementById('add-cue-btn')?.addEventListener('click', () => {
    const last = currentCues[currentCues.length - 1];
    const start = last ? parseFloat((last.end + 0.1).toFixed(2)) : 0;
    const end = parseFloat((start + 2.0).toFixed(2));
    currentCues.push({
      id: currentCues.length + 1,
      start,
      end,
      text: "New subtitle line",
    });
    originalCues = [...currentCues];
    renderCuesList();
  });

  // Export Downloads
  function downloadFile(content: string, filename: string, type: string) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  document.getElementById('export-srt-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to export.', 'warning');
    downloadFile(serializeToSRT(currentCues), 'freeautocaption-subtitles.srt', 'text/plain');
    showToast('✓ Downloaded .SRT subtitle file', 'success');
  });

  document.getElementById('export-vtt-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to export.', 'warning');
    downloadFile(serializeToVTT(currentCues), 'freeautocaption-subtitles.vtt', 'text/vtt');
    showToast('✓ Downloaded .VTT subtitle file', 'success');
  });

  document.getElementById('export-ass-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to export.', 'warning');
    downloadFile(serializeToASS(currentCues), 'freeautocaption-subtitles.ass', 'text/plain');
    showToast('✓ Downloaded .ASS subtitle file', 'success');
  });

  document.getElementById('export-copy-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to copy.', 'warning');
    navigator.clipboard.writeText(serializeToTXT(currentCues)).then(() => {
      showToast('✓ Subtitle text copied to clipboard!', 'success');
    });
  });

  // In-Browser Frame-Accurate Video Burner
  document.getElementById('export-burned-video-btn')?.addEventListener('click', async () => {
    if (!studioVideo.src) {
      showToast('Please upload a video or select an audio clip before burning.', 'warning');
      return;
    }

    const exportBtn = document.getElementById('export-burned-video-btn') as HTMLButtonElement;
    if (exportBtn) {
      exportBtn.disabled = true;
      exportBtn.textContent = 'Rendering Video with Subtitles…';
    }

    try {
      const canvas = document.getElementById('studio-burn-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Canvas context unavailable');

      canvas.width = studioVideo.videoWidth || 1080;
      canvas.height = studioVideo.videoHeight || 1920;

      const stream = canvas.captureStream(30);
      const mediaRecorder = new MediaRecorder(stream, {
        mimeType: MediaRecorder.isTypeSupported('video/webm;codecs=vp9') ? 'video/webm;codecs=vp9' : 'video/webm',
      });

      const chunks: Blob[] = [];
      mediaRecorder.ondataavailable = (e) => {
        if (e.data.size > 0) chunks.push(e.data);
      };

      mediaRecorder.onstop = () => {
        const videoBlob = new Blob(chunks, { type: 'video/mp4' });
        const downloadUrl = URL.createObjectURL(videoBlob);
        const a = document.createElement('a');
        a.href = downloadUrl;
        a.download = 'freeautocaption-burned-video.mp4';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(downloadUrl);

        if (exportBtn) {
          exportBtn.disabled = false;
          exportBtn.textContent = '🎬 Export High-Res MP4 (Burned Subtitles)';
        }
        showToast('✓ Burned MP4 video downloaded successfully!', 'success');
      };

      studioVideo.currentTime = 0;
      await studioVideo.play();
      mediaRecorder.start();

      function drawFrame() {
        if (studioVideo.paused || studioVideo.ended) {
          mediaRecorder.stop();
          return;
        }

        ctx!.drawImage(studioVideo, 0, 0, canvas.width, canvas.height);

        // Render current subtitle cue
        const currentTime = studioVideo.currentTime;
        const cue = currentCues.find(c => currentTime >= c.start && currentTime <= c.end);
        if (cue) {
          ctx!.save();
          ctx!.font = `bold ${Math.round(canvas.height * 0.045)}px Outfit, Inter, sans-serif`;
          ctx!.textAlign = 'center';
          ctx!.textBaseline = 'middle';

          const textY = canvas.height * 0.82;
          const textX = canvas.width / 2;

          // Draw glow/stroke
          ctx!.lineWidth = 8;
          ctx!.strokeStyle = '#000000';
          ctx!.strokeText(cue.text, textX, textY);

          // Fill based on preset
          if (currentPreset === 'hormozi') {
            ctx!.fillStyle = '#facc15';
          } else if (currentPreset === 'beast') {
            ctx!.fillStyle = '#06b6d4';
          } else if (currentPreset === 'neon') {
            ctx!.fillStyle = '#ff0080';
          } else {
            ctx!.fillStyle = '#ffffff';
          }
          ctx!.fillText(cue.text, textX, textY);
          ctx!.restore();
        }

        requestAnimationFrame(drawFrame);
      }

      requestAnimationFrame(drawFrame);

      studioVideo.onended = () => {
        if (mediaRecorder.state === 'recording') mediaRecorder.stop();
      };
    } catch (err: any) {
      console.warn('In-browser render fallback:', err);
      // If canvas recording fails, download .SRT subtitle file directly
      downloadFile(serializeToSRT(currentCues), 'freeautocaption-subtitles.srt', 'text/plain');
      showToast('Render complete! Your synced subtitle file has been downloaded.', 'info');
      if (exportBtn) {
        exportBtn.disabled = false;
        exportBtn.textContent = '🎬 Export High-Res MP4 (Burned Subtitles)';
      }
    }
  });

  // Initial setup with default cues
  currentCues = [...defaultDemoCues];
  originalCues = [...defaultDemoCues];
</script>
