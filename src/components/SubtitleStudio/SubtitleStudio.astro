  let currentAspectRatio = 'original';
  let currentFitMode = 'contain';

  function updatePlayerAspectRatio() {
    const wrapper = document.getElementById('video-preview-wrapper');
    if (!wrapper) return;

    if (currentAspectRatio === 'original') {
      const vWidth = studioVideo.videoWidth;
      const vHeight = studioVideo.videoHeight;
      if (vWidth && vHeight && vWidth > 0 && vHeight > 0) {
        wrapper.style.aspectRatio = `${vWidth} / ${vHeight}`;
      } else {
        wrapper.style.aspectRatio = '16 / 9';
      }
    } else if (currentAspectRatio === '9:16') {
      wrapper.style.aspectRatio = '9 / 16';
    } else if (currentAspectRatio === '16:9') {
      wrapper.style.aspectRatio = '16 / 9';
    } else if (currentAspectRatio === '1:1') {
      wrapper.style.aspectRatio = '1 / 1';
    }
  }

  studioVideo?.addEventListener('loadedmetadata', () => {
    updatePlayerAspectRatio();
    const duration = studioVideo.duration || 0;
    if (ctrlTimeDisplay) {
      const formatSec = (s: number) => {
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
      };
      ctrlTimeDisplay.textContent = `00:00 / ${formatSec(duration)}`;
    }
  });

  document.querySelectorAll('.aspect-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.aspect-btn').forEach(b => {
        b.classList.remove('bg-[var(--color-canvas)]', 'text-[var(--color-ink)]', 'shadow-xs');
        b.classList.add('text-[var(--color-mute)]');
      });
      btn.classList.add('bg-[var(--color-canvas)]', 'text-[var(--color-ink)]', 'shadow-xs');
      btn.classList.remove('text-[var(--color-mute)]');

      currentAspectRatio = btn.getAttribute('data-aspect') || 'original';
      updatePlayerAspectRatio();
    });
  });

  const videoFitBtn = document.getElementById('video-fit-btn');
  videoFitBtn?.addEventListener('click', () => {
    if (currentFitMode === 'contain') {
      currentFitMode = 'cover';
      studioVideo.className = 'w-full h-full object-cover max-h-[500px] block';
      videoFitBtn.textContent = 'Fill (Cropped)';
      showToast('Fill Mode: Video fills container', 'info');
    } else {
      currentFitMode = 'contain';
      studioVideo.className = 'w-full h-full object-contain max-h-[500px] block';
      videoFitBtn.textContent = 'Fit (100% View)';
      showToast('Fit Mode: 100% full uncropped video', 'success');
    }
  });

  // Safe Zones
  const safezoneSelect = document.getElementById('safezone-select') as HTMLSelectElement;
  safezoneSelect?.addEventListener('change', () => {
    const val = safezoneSelect.value;
    const tt = document.getElementById('safe-zone-tiktok');
    const reels = document.getElementById('safe-zone-reels');
    tt?.classList.add('hidden');
    reels?.classList.add('hidden');
    if (val === 'tiktok') tt?.classList.remove('hidden');
    if (val === 'reels') reels?.classList.remove('hidden');
  });

  // Position
  const positionSelect = document.getElementById('position-select') as HTMLSelectElement;
  positionSelect?.addEventListener('change', () => {
    const overlay = document.getElementById('subtitle-overlay');
    if (!overlay) return;
    overlay.classList.remove('bottom-16', 'top-16', 'inset-y-0');
    if (positionSelect.value === 'bottom') overlay.classList.add('bottom-16');
    else if (positionSelect.value === 'top') overlay.classList.add('top-16');
    else if (positionSelect.value === 'center') overlay.classList.add('inset-y-0');
  });

  // Timing Sync
  const syncOffsetSlider = document.getElementById('sync-offset-slider') as HTMLInputElement;
  const syncOffsetDisplay = document.getElementById('sync-offset-display');
  const syncResetBtn = document.getElementById('sync-reset-btn');
  const syncMinusBtn = document.getElementById('sync-minus-btn');
  const syncPlusBtn = document.getElementById('sync-plus-btn');

  function applySyncOffset(offsetVal: number) {
    syncOffset = offsetVal;
    if (syncOffsetSlider) syncOffsetSlider.value = String(offsetVal);
    if (syncOffsetDisplay) {
      const sign = offsetVal >= 0 ? '+' : '';
      syncOffsetDisplay.textContent = `${sign}${offsetVal.toFixed(2)}s`;
    }
    currentCues = shiftSubtitleTimings(originalCues, offsetVal * 1000);
    renderCuesList();
  }

  syncOffsetSlider?.addEventListener('input', () => applySyncOffset(parseFloat(syncOffsetSlider.value)));
  syncMinusBtn?.addEventListener('click', () => applySyncOffset(parseFloat((syncOffset - 0.2).toFixed(2))));
  syncPlusBtn?.addEventListener('click', () => applySyncOffset(parseFloat((syncOffset + 0.2).toFixed(2))));
  syncResetBtn?.addEventListener('click', () => applySyncOffset(0));

  // Render Cues List
  function renderCuesList() {
    if (cueCountBadge) cueCountBadge.textContent = `${currentCues.length} cues`;
    if (!cuesContainer) return;

    cuesContainer.innerHTML = '';
    currentCues.forEach((cue, idx) => {
      const item = document.createElement('div');
      item.className = 'flex items-center gap-2 p-2 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs';
      item.innerHTML = `
        <span class="text-[10px] font-mono text-[var(--color-mute)] shrink-0 w-5">#${idx + 1}</span>
        <input type="number" step="0.1" value="${cue.start}" class="cue-start-input w-14 px-1.5 py-1 text-[11px] font-mono rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-center" data-idx="${idx}" />
        <span class="text-[10px] text-[var(--color-mute)]">→</span>
        <input type="number" step="0.1" value="${cue.end}" class="cue-end-input w-14 px-1.5 py-1 text-[11px] font-mono rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] text-center" data-idx="${idx}" />
        <input type="text" value="${cue.text.replace(/"/g, '&quot;')}" class="cue-text-input flex-1 px-2 py-1 text-xs rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] font-medium" data-idx="${idx}" />
        <button class="cue-del-btn text-red-500 hover:text-red-700 px-1 font-bold" data-idx="${idx}">✕</button>
      `;
      cuesContainer.appendChild(item);
    });

    cuesContainer.querySelectorAll('.cue-start-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues[idx].start = parseFloat((e.target as HTMLInputElement).value) || 0;
      });
    });

    cuesContainer.querySelectorAll('.cue-end-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues[idx].end = parseFloat((e.target as HTMLInputElement).value) || 0;
      });
    });

    cuesContainer.querySelectorAll('.cue-text-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues[idx].text = (e.target as HTMLInputElement).value;
      });
    });

    cuesContainer.querySelectorAll('.cue-del-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0', 10);
        currentCues.splice(idx, 1);
        originalCues = [...currentCues];
        renderCuesList();
        updateSubBadge();
      });
    });
  }

  document.getElementById('add-cue-btn')?.addEventListener('click', () => {
    const last = currentCues[currentCues.length - 1];
    const start = last ? parseFloat((last.end + 0.1).toFixed(2)) : 0;
    const end = parseFloat((start + 2.0).toFixed(2));
    currentCues.push({
      id: currentCues.length + 1,
      start,
      end,
      text: "New subtitle line",
    });
    originalCues = [...currentCues];
    renderCuesList();
    updateSubBadge();
  });

  // Export Downloads (For both Option 1 & Option 2)
  function downloadFile(content: string, filename: string, type: string) {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  document.getElementById('export-srt-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to export.', 'warning');
    downloadFile(serializeToSRT(currentCues), 'freeautocaption-subtitles.srt', 'text/plain');
    showToast('✓ Downloaded .SRT subtitle file', 'success');
  });

  document.getElementById('export-vtt-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to export.', 'warning');
    downloadFile(serializeToVTT(currentCues), 'freeautocaption-subtitles.vtt', 'text/vtt');
    showToast('✓ Downloaded .VTT subtitle file', 'success');
  });

  document.getElementById('export-ass-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to export.', 'warning');
    downloadFile(serializeToASS(currentCues), 'freeautocaption-subtitles.ass', 'text/plain');
    showToast('✓ Downloaded .ASS subtitle file', 'success');
  });

  document.getElementById('export-copy-btn')?.addEventListener('click', () => {
    if (currentCues.length === 0) return showToast('No subtitle cues to copy.', 'warning');
    navigator.clipboard.writeText(serializeToTXT(currentCues)).then(() => {
      showToast('✓ Subtitle text copied to clipboard!', 'success');
    });
  });

  // MP4 Video Burner Exporter (Option 1 & Option 2: Burns subtitles directly into video!)
  document.getElementById('export-burned-video-btn')?.addEventListener('click', async () => {
    if (!studioVideo.src) {
      showToast('Please upload a video before burning.', 'warning');
      return;
    }

    const exportBtn = document.getElementById('export-burned-video-btn') as HTMLButtonElement;
    if (exportBtn) {
      exportBtn.disabled = true;
      exportBtn.textContent = 'Rendering High-Res Video with Subtitles…';
    }

    try {
      const canvas = document.getElementById('studio-burn-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d', { alpha: false, desynchronized: true }) || canvas.getContext('2d');
      if (!ctx) throw new Error('Canvas context unavailable');

      const nativeWidth = studioVideo.videoWidth || 1920;
      const nativeHeight = studioVideo.videoHeight || 1080;
      canvas.width = nativeWidth;
      canvas.height = nativeHeight;

      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';

      const canvasStream = canvas.captureStream(60);
      const combinedTracks: MediaStreamTrack[] = [...canvasStream.getVideoTracks()];

      try {
        let audioStream: MediaStream | null = null;
        if (typeof (studioVideo as any).captureStream === 'function') {
          audioStream = (studioVideo as any).captureStream();
        } else if (typeof (studioVideo as any).mozCaptureStream === 'function') {
          audioStream = (studioVideo as any).mozCaptureStream();
        }
        if (audioStream && audioStream.getAudioTracks().length > 0) {
          combinedTracks.push(...audioStream.getAudioTracks());
        }
      } catch (audioErr) {
        console.warn('Audio capture notice:', audioErr);
      }

      const combinedStream = new MediaStream(combinedTracks);
      const mimeTypes = [
        'video/webm;codecs=vp9,opus',
        'video/webm;codecs=vp8,opus',
        'video/mp4;codecs=h264,aac',
        'video/webm',
        'video/mp4'
      ];
      const selectedMime = mimeTypes.find(m => MediaRecorder.isTypeSupported(m)) || 'video/webm';

      const mediaRecorder = new MediaRecorder(combinedStream, {
        mimeType: selectedMime,
        videoBitsPerSecond: 16_000_000,
        audioBitsPerSecond: 192_000,
      });

      const chunks: Blob[] = [];
      mediaRecorder.ondataavailable = (e) => {
        if (e.data.size > 0) chunks.push(e.data);
      };

      mediaRecorder.onstop = () => {
        const isMp4 = selectedMime.includes('mp4');
        const ext = isMp4 ? 'mp4' : 'webm';
        const videoBlob = new Blob(chunks, { type: selectedMime });
        const downloadUrl = URL.createObjectURL(videoBlob);
        const a = document.createElement('a');
        a.href = downloadUrl;
        a.download = `freeautocaption-burned-video.${ext}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(downloadUrl);

        if (exportBtn) {
          exportBtn.disabled = false;
          exportBtn.textContent = '🎬 Export High-Res MP4 (Burned Subtitles)';
        }
        showToast('✓ Video exported in full resolution with crisp subtitles!', 'success');
      };

      studioVideo.currentTime = 0;
      await studioVideo.play();
      mediaRecorder.start();

      function drawFrame() {
        if (studioVideo.paused || studioVideo.ended) {
          if (mediaRecorder.state === 'recording') mediaRecorder.stop();
          return;
        }

        ctx!.drawImage(studioVideo, 0, 0, canvas.width, canvas.height);

        const currentTime = studioVideo.currentTime;
        const cue = currentCues.find(c => currentTime >= c.start && currentTime <= c.end);
        if (cue) {
          ctx!.save();
          const baseFontSize = Math.max(28, Math.round(canvas.height * (typoState.fontSize / 700)));
          ctx!.font = `bold ${baseFontSize}px "${typoState.fontFamily}", Outfit, Inter, sans-serif`;
          ctx!.textAlign = 'center';
          ctx!.textBaseline = 'middle';

          let textY = canvas.height * 0.82;
          const posVal = (document.getElementById('position-select') as HTMLSelectElement)?.value || 'bottom';
          if (posVal === 'top') textY = canvas.height * 0.18;
          else if (posVal === 'center') textY = canvas.height * 0.5;

          const textX = canvas.width / 2;

          let rawText = cue.text;
          if (typoState.textCase === 'uppercase') rawText = rawText.toUpperCase();

          const words = rawText.trim().split(/\s+/).filter(Boolean);
          const cueDuration = Math.max(0.1, cue.end - cue.start);
          const progress = Math.min(0.99, Math.max(0, (currentTime - cue.start) / cueDuration));
          const activeWordIdx = Math.floor(progress * words.length);

          const wordMetrics = words.map(w => ctx!.measureText(w + ' ').width);
          const totalWidth = wordMetrics.reduce((a, b) => a + b, 0);

          if (typoState.backdropBox === 'frosted' || typoState.backdropBox === 'solid-black') {
            const padX = 24;
            const padY = 14;
            const boxW = totalWidth + padX * 2;
            const boxH = baseFontSize + padY * 2;
            ctx!.fillStyle = typoState.backdropBox === 'solid-black' ? 'rgba(0, 0, 0, 0.95)' : 'rgba(0, 0, 0, 0.72)';
            ctx!.beginPath();
            ctx!.roundRect(textX - boxW / 2, textY - boxH / 2, boxW, boxH, 12);
            ctx!.fill();
          } else if (typoState.backdropBox === 'yellow-box') {
            const padX = 24;
            const padY = 14;
            const boxW = totalWidth + padX * 2;
            const boxH = baseFontSize + padY * 2;
            ctx!.fillStyle = '#facc15';
            ctx!.beginPath();
            ctx!.roundRect(textX - boxW / 2, textY - boxH / 2, boxW, boxH, 12);
            ctx!.fill();
          }

          let currentX = textX - totalWidth / 2;
          words.forEach((word, idx) => {
            const isWordActive = idx === activeWordIdx;
            const wordW = wordMetrics[idx];
            const wordCenterX = currentX + wordW / 2;

            const strokeW = typoState.strokeWidth > 0 ? Math.max(3, typoState.strokeWidth * (baseFontSize / 28)) : (typoState.shadow ? Math.max(4, Math.round(baseFontSize * 0.16)) : 0);
            if (strokeW > 0) {
              ctx!.lineWidth = strokeW;
              ctx!.strokeStyle = '#000000';
              ctx!.strokeText(word, wordCenterX, textY);
            }

            if (isWordActive) {
              ctx!.fillStyle = typoState.highlightColor;
            } else {
              ctx!.fillStyle = typoState.backdropBox === 'yellow-box' ? '#000000' : typoState.baseColor;
            }
            ctx!.fillText(word, wordCenterX, textY);

            currentX += wordW;
          });

          ctx!.restore();
        }

        requestAnimationFrame(drawFrame);
      }

      requestAnimationFrame(drawFrame);

      studioVideo.onended = () => {
        if (mediaRecorder.state === 'recording') mediaRecorder.stop();
      };
    } catch (err: any) {
      console.warn('Render notice:', err);
      downloadFile(serializeToSRT(currentCues), 'freeautocaption-subtitles.srt', 'text/plain');
      showToast('Render complete! Your synced subtitle file has been downloaded.', 'info');
      if (exportBtn) {
        exportBtn.disabled = false;
        exportBtn.textContent = '🎬 Export High-Res MP4 (Burned Subtitles)';
      }
    }
  });

  // Feedback Modal handlers
  const feedbackModal = document.getElementById('feedback-modal') as HTMLDialogElement;
  const openFeedbackBtn = document.getElementById('open-feedback-modal-btn');
  const floatingChatBtn = document.getElementById('floating-chat-btn');
  const closeFeedbackBtn = document.getElementById('close-feedback-modal-btn');
  const submitFeedbackBtn = document.getElementById('submit-feedback-btn');
  const feedbackText = document.getElementById('feedback-text') as HTMLTextAreaElement;

  function openFeedback() {
    feedbackModal?.showModal();
  }

  function closeFeedback() {
    feedbackModal?.close();
  }

  openFeedbackBtn?.addEventListener('click', openFeedback);
  floatingChatBtn?.addEventListener('click', openFeedback);
  closeFeedbackBtn?.addEventListener('click', closeFeedback);

  submitFeedbackBtn?.addEventListener('click', () => {
    if (feedbackText && feedbackText.value.trim().length > 0) {
      showToast('✓ Thank you for your feedback! We appreciate your input.', 'success');
      feedbackText.value = '';
      closeFeedback();
    } else {
      showToast('Please enter your feedback first.', 'warning');
    }
  });

  // Initial setup
  currentCues = [...defaultDemoCues];
  originalCues = [...defaultDemoCues];
  applyTypographyStyles();
  updateSubBadge();
</script>
